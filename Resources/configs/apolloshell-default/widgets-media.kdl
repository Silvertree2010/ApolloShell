style "widgets-media.css"

define "wm-arc" {
    param "s"
    param "line"
    param "sym"
    stack class="wm-arc" style="width: {s}px; height: {s}px" {
        ring value="{media.progress ?? 0}" gap=0.06 class="card-media-arc" style="width: {s}px; height: {s}px; -apollo-stroke-width: {line}px"
        stack class="card-media-disc" style="width: {s - 2 * (line + 4)}px; height: {s - 2 * (line + 4)}px" {
            icon "music.note" class="card-media-placeholder" style="font-size: {sym}px"
            image "{media.artwork}" fit="fill" class="card-media-disc-art" style="width: {s - 2 * (line + 4)}px; height: {s - 2 * (line + 4)}px"
        }
    }
}

define "wm-picture" {
    param "width"
    param "height"
    param "radius"
    param "sym"
    param "note"
    stack class="wm-picture" style="width: {width}px; height: {height}px; border-radius: {radius}px" {
        icon "{note}" class="wm-picture-note" style="font-size: {sym}px"
        image "{media.artwork}" fit="fill" class="wm-picture-image" style="width: {width}px; height: {height}px; border-radius: {radius}px"
    }
}

define "wm-bar" {
    param "tint"
    stack class="wm-bar" {
        progress value="{media.duration != null ? (media.progress ?? 0) : 0}" class="wm-bar-fill {tint}"
    }
}

define "wm-controls" {
    param "h"
    param "sym"
    param "gap"
    param "dark"
    row class="wm-controls {dark}" style="gap: {gap}px; opacity: {media.title != null ? 1 : 0.4}" {
        button class="wm-button" style="width: {h}px; height: {h}px" {
            on-click { media.previous }
            icon "backward.fill" class="wm-glyph" style="font-size: {sym}px"
        }
        button class="wm-play {media.playing ? 'on' : ''}" style="height: {h}px; border-radius: {media.playing ? h * 0.32 : h / 2}px" {
            on-click { media.play-pause }
            icon "{media.playing ? 'pause.fill' : 'play.fill'}" class="wm-glyph" style="font-size: {sym + 2}px"
        }
        button class="wm-button" style="width: {h}px; height: {h}px" {
            on-click { media.next }
            icon "forward.fill" class="wm-glyph" style="font-size: {sym}px"
        }
    }
}

define "wm-chip" {
    row class="card-media-source" {
        when "{media.app != null}" { app-icon "{media.app}" class="card-media-source-icon" }
        else { icon "app.dashed" class="card-media-source-fallback" }
        text "{media.app-name ?? 'Unknown App'}" class="card-media-source-name" lines=1
        icon "{media.playing ? 'waveform' : 'pause.fill'}" class="card-media-source-state"
    }
}

define "wm-idle" {
    param "big"
    text "{media.unavailable != null && media.unavailable != '' ? 'Not Available' : 'Nothing Playing'}" class="wm-title idle" style="font-size: {big}px" lines=1
    text "{media.unavailable != null && media.unavailable != '' ? 'Adapter Not Running' : 'Play Something'}" class="wm-sub" lines=1
}

define "wm-lines" {
    param "text"
    param "cls"
    param "sty"
    param "n"
    switch "{n}" {
        case 3 { text "{text}" class="{cls}" style="{sty}" lines=3 truncate="tail" }
        case 2 { text "{text}" class="{cls}" style="{sty}" lines=2 truncate="tail" }
        default { text "{text}" class="{cls}" style="{sty}" lines=1 truncate="tail" }
    }
}

define "wm-dash" {
    param "w"
    column class="card wm-dash" {
        when "{media.kind == 'video'}" {
            stack style="height: 34px" class="wm-gap"
            use "wm-picture" width=168 height=95 radius=18 sym=30 note="play.rectangle"
            column class="wm-bar-box" style="padding-top: 12px; width: 168px" { use "wm-bar" tint="" }
        }
        else {
            stack style="height: 22px" class="wm-gap"
            use "wm-arc" s=164 line=6 sym=40
        }
        column class="wm-texts" style="padding-top: 14px; width: 168px; gap: 4px" {
            when "{media.title != null}" {
                use "wm-lines" text="{media.title}" cls="wm-title" sty="" n="{media.kind == 'video' ? 3 : 1}"
                when "{w.show-album && media.album != null && media.album != ''}" { text "{media.album}" class="wm-album" lines=1 truncate="tail" }
                text "{media.artist ?? 'Unknown Artist'}" class="wm-sub" lines=1 truncate="tail"
            }
            else { use "wm-idle" big=14 }
        }
        column class="wm-controls-box" style="padding: 14px 16px 0; align-self: stretch" { use "wm-controls" h=40 sym=15 gap=4 dark="" }
        spacer
        when "{w.show-source && media.title != null}" {
            column class="wm-chip-box" style="padding-bottom: 22px; max-width: 168px" { use "wm-chip" }
        }
    }
}

define "wm-compact" {
    param "w"
    column class="card wm-compact" {
        when "{media.kind == 'video'}" {
            use "wm-picture" width=168 height=95 radius=14 sym=30 note="play.rectangle"
            column class="wm-bar-box" style="padding-top: 10px; width: 168px" { use "wm-bar" tint="" }
        }
        else { use "wm-arc" s=112 line=5 sym=28 }
        column class="wm-texts" style="padding-top: 10px; max-width: 168px; gap: 2px" {
            when "{media.title != null}" {
                text "{media.title}" class="wm-title small" lines=1 truncate="tail"
                text "{media.artist ?? 'Unknown Artist'}" class="wm-sub small" lines=1 truncate="tail"
            }
            else { use "wm-idle" big=13 }
        }
        column class="wm-controls-box" style="padding-top: 10px; width: 168px; flex-shrink: 1" { use "wm-controls" h=34 sym=13 gap=4 dark="" }
    }
}

define "wm-strip" {
    param "w"
    row class="card wm-strip" style="gap: 16px; padding: 16px" {
        use "wm-strip-body" w="{w}" cv="{(w.height - 32) | max 40 | min 244}"
    }
}

define "wm-strip-body" {
    param "w"
    param "cv"
    use "wm-picture" width="{media.kind == 'video' ? ((cv * 16 / 9) | min (w.width * 0.45) | round) : cv}" height="{media.kind == 'video' ? (((cv * 16 / 9) | min (w.width * 0.45)) * 9 / 16 | round) : cv}" radius=18 sym="{cv * 0.32}" note="{media.kind == 'video' ? 'play.rectangle' : 'music.note'}"
    column class="wm-strip-text" {
        when "{media.title != null}" {
            use "wm-lines" text="{media.title}" cls="wm-title left" sty="" n="{media.kind == 'video' && w.height >= 200 ? 2 : 1}"
            text "{media.artist ?? 'Unknown Artist'}{w.show-album && media.album != null && media.album != '' ? ' · ' + media.album : ''}" class="wm-sub left" lines=1 truncate="tail"
        }
        else { use "wm-idle" big=14 }
        column style="padding-top: 6px; align-self: stretch" { use "wm-bar" tint="" }
        column style="padding-top: 8px; width: 200px; flex-shrink: 1" { use "wm-controls" h=34 sym=13 gap=4 dark="" }
    }
}

define "wm-cover" {
    param "w"
    stack class="card wm-cover" style="width: {w.width}px; height: {w.height}px" {
        image "{media.artwork}" fit="fill" class="wm-cover-image" style="width: {w.width}px; height: {w.height}px"
        stack class="wm-veil" style="width: {w.width}px; height: {w.height}px"
        column class="wm-cover-text" style="width: {w.width}px; height: {w.height}px; padding: {w.height >= 300 && w.width >= 400 ? 24 : 14}px; gap: {w.height >= 300 && w.width >= 400 ? 4 : 2}px" {
            when "{media.title != null}" {
                text "{media.title}" class="wm-cover-title" style="font-size: {w.height >= 300 && w.width >= 400 ? 24 : 15}px" lines=1 truncate="tail"
                text "{media.artist ?? 'Unknown Artist'}" class="wm-cover-artist" style="font-size: {w.height >= 300 && w.width >= 400 ? 15 : 12}px" lines=1 truncate="tail"
                column style="padding-top: {w.height >= 300 && w.width >= 400 ? 12 : 6}px; align-self: stretch" { use "wm-bar" tint="white" }
            }
            else { text "Nothing Playing" class="wm-cover-title" style="font-size: {w.height >= 300 && w.width >= 400 ? 22 : 14}px" lines=1 }
            column style="padding-top: {w.height >= 300 && w.width >= 400 ? 12 : 6}px; width: {w.height >= 300 && w.width >= 400 ? 260 : 180}px; flex-shrink: 1" {
                use "wm-controls" h="{w.height >= 300 && w.width >= 400 ? 44 : 30}" sym="{w.height >= 300 && w.width >= 400 ? 17 : 12}" gap=6 dark="dark"
            }
        }
    }
}

define "wm-tab" {
    param "w"
    row class="card wm-tab" style="gap: 24px; padding: 0 24px" {
        use "wm-tab-body" w="{w}" cv="{(w.height - 48) | min (w.width * 0.34) | min 244}" pw="{(w.width * 0.45) | min ((w.height - 48) * 16 / 9) | min 400}"
    }
}

define "wm-tab-body" {
    param "w"
    param "cv"
    param "pw"
    use "wm-picture" width="{media.kind == 'video' ? pw : cv}" height="{media.kind == 'video' ? (pw * 9 / 16 | round) : cv}" radius=22 sym="{cv * 0.26}" note="{media.kind == 'video' ? 'play.rectangle' : 'music.note'}"
    column class="wm-tab-rest" {
        when "{media.title != null}" {
            row class="wm-tab-body" style="gap: 24px" {
                column class="wm-details" {
                    use "wm-lines" text="{media.title}" cls="wm-tab-title" sty="font-size: {w.height < 300 || media.kind == 'video' ? 18 : 22}px" n="{media.kind == 'video' ? 3 : (w.height < 300 ? 1 : 2)}"
                    when "{media.artist != null || media.kind != 'video'}" {
                        text "{media.artist ?? 'Unknown Artist'}" class="wm-tab-artist" style="font-size: {w.height < 300 || media.kind == 'video' ? 14 : 16}px" lines=1
                    }
                    when "{media.kind == 'video'}" { column style="padding-top: 4px; align-self: start" { use "wm-chip" } }
                    when "{media.kind != 'video' && media.album != null && media.album != ''}" {
                        text "{media.album}" class="wm-tab-album" style="font-size: {w.height < 300 ? 14 : 16}px" lines=1
                    }
                    row class="wm-times" style="padding-top: {w.height < 300 || media.kind == 'video' ? 12 : 26}px" {
                        text "{(media.elapsed ?? 0) | duration 'clock'}" class="media-time"
                        stack class="wm-times-bar" { use "wm-bar" tint="" }
                        text "{media.duration != null ? '-' + ((media.duration - (media.elapsed ?? 0)) | duration 'clock') : '--:--'}" class="media-time"
                    }
                    column style="padding-top: {w.height < 300 || media.kind == 'video' ? 10 : 18}px; align-self: stretch" {
                        use "wm-controls" h="{w.height < 300 || media.kind == 'video' ? 40 : 52}" sym="{w.height < 300 || media.kind == 'video' ? 16 : 20}" gap=6 dark=""
                    }
                }
                when "{w.width >= 700 && media.kind != 'video'}" {
                    column class="media-source-panel" style="height: {cv}px" {
                        row class="media-source-head" {
                            icon "hifispeaker.fill" class="media-source-head-glyph"
                            text "Source" class="media-source-head-title"
                        }
                        button class="media-source" {
                            on-click { media.open-app }
                            column class="media-source-body" {
                                when "{media.app != null}" { app-icon "{media.app}" class="media-source-icon" }
                                else { icon "app.dashed" class="media-source-fallback" }
                                text "{media.app-name ?? 'Unknown App'}" class="media-source-name" lines=1
                                row class="media-source-state" {
                                    icon "{media.playing ? 'waveform' : 'pause.fill'}" class="media-source-wave"
                                    text "{media.playing ? 'Playing' : 'Paused'}" class="media-source-state-text"
                                }
                            }
                        }
                    }
                }
            }
        }
        else {
            column class="media-empty" {
                stack class="media-empty-badge" { icon "music.note.list" class="media-empty-glyph" }
                text "Nothing Playing" class="media-empty-title"
                text "Play something, and it will appear here." class="media-empty-detail"
            }
        }
    }
}

define "widget-media" {
    param "w"
    switch "{w.display}" {
        case "cover" { use "wm-cover" w="{w}" }
        default {
            when "{w.width > w.height * 1.3}" { use "wm-strip" w="{w}" }
            else {
                when "{w.height >= 330}" { use "wm-dash" w="{w}" }
                else { use "wm-compact" w="{w}" }
            }
        }
    }
}

define "widget-media-player" {
    param "w"
    switch "{w.display}" {
        case "cover" { use "wm-cover" w="{w}" }
        default { use "wm-tab" w="{w}" }
    }
}

var nexus-tab "bar"
var nexus-shown #true persist=#true
var nexus-file-pick ""
var feature-dashboard #true persist=#true
var feature-utilities #true persist=#true
var feature-off-a from="{var.feature-dashboard ? '-' : 'dashboard-button'}"
var feature-off-b from="{var.feature-utilities ? '-' : 'utilities-button'}"

var nexus-mb-templates from="{[[((var.menubar-macos.start | count) > 0 ? var.menubar-macos.start : []), ((var.menubar-macos.center | count) > 0 ? var.menubar-macos.center : []), ((var.menubar-macos.end | count) > 0 ? var.menubar-macos.end : [])], [((var.menubar-serpantinum.start | count) > 0 ? var.menubar-serpantinum.start : []), ((var.menubar-serpantinum.center | count) > 0 ? var.menubar-serpantinum.center : []), ((var.menubar-serpantinum.end | count) > 0 ? var.menubar-serpantinum.end : [])], [((var.menubar-minimal.start | count) > 0 ? var.menubar-minimal.start : []), ((var.menubar-minimal.center | count) > 0 ? var.menubar-minimal.center : []), ((var.menubar-minimal.end | count) > 0 ? var.menubar-minimal.end : [])], [((var.menubar-clock-only.start | count) > 0 ? var.menubar-clock-only.start : []), ((var.menubar-clock-only.center | count) > 0 ? var.menubar-clock-only.center : []), ((var.menubar-clock-only.end | count) > 0 ? var.menubar-clock-only.end : [])]]}"

var nexus-tabs {
    - id="bar" title="Bar" symbol="sidebar.left"
    - id="menubar" title="Menu Bar" symbol="rectangle.topthird.inset.filled"
    - id="themes" title="Themes" symbol="paintpalette"
    - id="toasts" title="Toasts" symbol="bell.badge"
    - id="providers" title="Providers" symbol="cloud.sun"
    - id="system" title="System" symbol="gearshape"
    - id="updates" title="Updates" symbol="arrow.triangle.2.circlepath"
}

var nexus-weather {
    - id="open-meteo" title="Open-Meteo" detail="7 days · hourly"
    - id="met-norway" title="MET Norway" detail="9 days · hourly · without chance of rain and feels-like temperature · sun times for today only"
    - id="wttr" title="wttr.in" detail="3 days · every 3 hours"
}

var nexus-update-text {
    idle "Up to date, as far as known"
    checking "Checking…"
    failed "Last check failed"
    unavailable "Updates unavailable in this build"
}

on "user.feature-dashboard" { when "{!var.feature-dashboard}" { close "dashboard" } }
on "user.feature-utilities" { when "{!var.feature-utilities}" { close "utilities" } }
on "shell.reopened" { set "nexus-shown" #true; open "nexus" }
on "user.nexus-open" { open "nexus" }
on "user.nexus-providers" { set "nexus-tab" "providers"; open "nexus" }

define "nexus-card" {
    param "symbol"
    param "title"
    param "detail" default=""
    param "foot" default=#false
    column class="nexus-card" {
        row class="nexus-card-head" {
            icon "{symbol}" class="nexus-card-symbol"
            column class="nexus-card-text" {
                text "{title}" class="nexus-card-title" lines=0
                when "{detail != ''}" { text "{detail}" class="nexus-card-detail" lines=0 }
            }
            slot "side"
        }
        when "{foot}" {
            column class="nexus-card-foot" { slot }
        }
    }
}

define "nexus-switch" {
    param "on"
    param "disabled" default=#false
    button class="nexus-switch" checked="{on}" disabled="{disabled}" label="{on ? 'On' : 'Off'}" {
        slot
        row class="nexus-switch-track" {
            stack class="nexus-switch-knob"
        }
    }
}

define "nexus-switch-card" {
    param "symbol"
    param "title"
    param "detail" default=""
    param "on"
    param "disabled" default=#false
    use "nexus-card" symbol="{symbol}" title="{title}" detail="{detail}" {
        fill "side" {
            use "nexus-switch" on="{on}" disabled="{disabled}" { slot }
        }
    }
}

define "nexus-option" {
    param "title"
    param "detail" default=""
    param "on"
    button class="nexus-option" checked="{on}" {
        slot
        row class="nexus-option-row" {
            column class="nexus-option-text" {
                text "{title}" class="nexus-option-title"
                when "{detail != ''}" { text "{detail}" class="nexus-option-detail" lines=1 }
            }
            when "{on}" { icon "checkmark" class="nexus-option-tick" }
        }
    }
}

define "nexus-small" {
    param "title"
    param "prominent" default=#false
    param "disabled" default=#false
    button class="nexus-small{prominent ? ' prominent' : ''}" disabled="{disabled}" {
        slot
        text "{title}" class="nexus-small-title" lines=1
    }
}

define "nexus-tile" {
    param "title"
    param "symbol"
    param "label" default=""
    param "lit" default=#false
    param "toggle" default=#true
    param "disabled" default=#false
    button class="nexus-tile{toggle ? ' feature' : ''}" checked="{lit}" disabled="{disabled}" label="{label == '' ? title : label}" tooltip="{toggle ? (lit ? 'On – click to switch off' : 'Off – click to switch on') : ''}" {
        slot
        column class="nexus-tile-body" {
            icon "{symbol}" class="nexus-tile-glyph"
            text "{title}" class="nexus-tile-title" lines=1
        }
    }
}

define "nexus-foot" {
    param "title"
    param "symbol"
    button class="nexus-foot" {
        slot
        row class="nexus-foot-row" {
            icon "{symbol}" class="nexus-foot-glyph"
            text "{title}" class="nexus-foot-title"
        }
    }
}

define "nexus-screens" {
    param "detail" default=""
    param "name"
    param "value"
    use "nexus-card" symbol="display.2" title="Screens" detail="{detail}" foot=#true {
        column class="nexus-options" {
            use "nexus-option" title="All Screens" on="{value == 'all'}" { on-click { set "{name}" "all" } }
            use "nexus-option" title="Main Display Only" on="{value == 'main'}" { on-click { set "{name}" "main" } }
            each monitor in="{screens.list}" key="{monitor.id}" {
                use "nexus-option" title="{monitor.name}" on="{value == monitor.id}" { on-click { set "{name}" "{monitor.id}" } }
            }
            when "{value != 'all' && value != 'main' && (screens.list | where 'id' value | count) == 0}" {
                use "nexus-option" title="{value} (not connected)" on=#true { }
            }
        }
    }
}

define "nexus-page-bar" {
    use "nexus-screens" detail="Where the bar stands – and with it the desktop clock and the strip kept clear of windows." name="sidebar-screens" value="{var.sidebar-screens}"
}

define "nexus-preset" {
    param "preset"
    param "value"
    use "nexus-option" title="{preset.title}" detail="{preset.summary}" on="{var.menubar-start == ((value.start | count) > 0 ? value.start : []) && var.menubar-center == ((value.center | count) > 0 ? value.center : []) && var.menubar-end == ((value.end | count) > 0 ? value.end : [])}" {
        on-click {
            set "menubar-start" "{(value.start | count) > 0 ? value.start : []}"
            set "menubar-center" "{(value.center | count) > 0 ? value.center : []}"
            set "menubar-end" "{(value.end | count) > 0 ? value.end : []}"
            emit "menubar-apply"
        }
    }
}

define "nexus-page-menubar" {
    use "nexus-switch-card" symbol="power" title="Show Menu Bar" detail="{(var.menubar-start | count) + (var.menubar-center | count) + (var.menubar-end | count) == 0 ? 'Empty - pick a template below first.' : 'Across the top of the screen.'}" on="{var.menubar-enabled}" {
        on-click { set "menubar-enabled" "{!var.menubar-enabled}"; emit "menubar-apply" }
    }
    use "nexus-card" symbol="square.grid.3x1.below.line.grid.1x2" title="Template" detail="Replaces what stands in the bar. Arrange it further in the edit mode." foot=#true {
        column class="nexus-options" {
            each preset in="{var.menubar-presets}" key="{preset.id}" {
                use "nexus-preset" preset="{preset}" value="{preset.id == 'macos' ? var.menubar-macos : (preset.id == 'serpantinum' ? var.menubar-serpantinum : (preset.id == 'minimal' ? var.menubar-minimal : var.menubar-clock-only))}"
            }
            when "{!(var.nexus-mb-templates | contains [var.menubar-start, var.menubar-center, var.menubar-end])}" {
                use "nexus-option" title="Custom" detail="Changed in the edit mode" on=#true { }
            }
        }
    }
    use "nexus-card" symbol="capsule" title="Style" foot=#true {
        column class="nexus-options" {
            use "nexus-option" title="Strip" detail="One strip across the whole width" on="{var.menubar-style == 'fill'}" { on-click { set "menubar-style" "fill" } }
            use "nexus-option" title="Islands" detail="Every group floats on its own" on="{var.menubar-style == 'islands'}" { on-click { set "menubar-style" "islands" } }
        }
    }
    when "{var.menubar-style == 'fill'}" {
        use "nexus-switch-card" symbol="square.split.2x1" title="Distinct Groups" detail="Every group gets its own lighter capsule on the strip." on="{var.menubar-distinct}" {
            on-click { set "menubar-distinct" "{!var.menubar-distinct}" }
        }
    }
    use "nexus-card" symbol="arrow.up.and.down" title="Thickness" foot=#true {
        fill "side" { text "{var.menubar-thickness} pt" class="nexus-value" }
        slider value="{var.menubar-thickness}" min=24 max=64 step=1 track-size=6 ticks=#true class="nexus-slider" {
            on-change { set "menubar-thickness" "{event.value | round}" }
        }
    }
    use "nexus-card" symbol="wifi" title="Status Icons" foot=#true {
        column class="nexus-options" {
            use "nexus-option" title="Icons" detail="Glyphs side by side, as in the sidebar" on="{var.menubar-status-style == 'icons'}" { on-click { set "menubar-status-style" "icons" } }
            use "nexus-option" title="Pills" detail="Coloured capsules with a short text" on="{var.menubar-status-style == 'pills'}" { on-click { set "menubar-status-style" "pills" } }
        }
    }
    use "nexus-screens" name="menubar-screens" value="{var.menubar-screens}"
    use "nexus-switch-card" symbol="menubar.rectangle" title="Cover Apple's Menu Bar" detail="Lie over Apple's menu bar instead of below it." on="{var.menubar-covers}" {
        on-click { set "menubar-covers" "{!var.menubar-covers}" }
    }
    use "nexus-switch-card" symbol="menubar.dock.rectangle" title="Hide Apple's Menu Bar" detail="More room for windows. Other apps' status items then show without their images." on="{var.menubar-hide-apple}" {
        on-click { set "menubar-hide-apple" "{!var.menubar-hide-apple}"; emit "menubar-apply" }
    }
}

define "nexus-page-themes" {
    when "{shell.themes == null}" {
        use "nexus-card" symbol="paintpalette" title="Themes" detail="Themes are not available in this build."
    }
    else {
        use "nexus-card" symbol="paintpalette" title="Theme" detail="A change to the file takes effect at once." foot=#true {
            column class="nexus-options" {
                use "nexus-option" title="No Theme" detail="The colours of macOS" on="{theme.id == null}" { on-click { close "nexus"; theme.select #null } }
                each item in="{shell.themes}" key="{item.id}" {
                    use "nexus-option" title="{item.name}" detail="{item.author != '' && (item.issues | count) > 0 ? item.author + ' · ' + (item.issues | count) + ' note(s)' : (item.author != '' ? item.author : ((item.issues | count) > 0 ? (item.issues | count) + ' note(s)' : ''))}" on="{theme.id == item.id}" { on-click { close "nexus"; theme.select "{item.id}" } }
                }
            }
        }
        use "nexus-card" symbol="bag" title="Marketplace" detail="Themes made by others, ready to use. Share your own there too." foot=#true {
            row class="nexus-smalls" {
                use "nexus-small" title="Open Marketplace…" { on-click { close "nexus"; marketplace.open } }
            }
        }
        use "nexus-card" symbol="folder" title="Theme Folder" detail="{shell.themes-folder ?? ''}" foot=#true {
            row class="nexus-smalls" {
                use "nexus-small" title="Add Theme…" { on-click { close "nexus"; theme.import } }
                use "nexus-small" title="Show in Finder" { on-click { theme.open-folder } }
                use "nexus-small" title="Read Again" { on-click { shell.reload-config } }
            }
        }
    }
}

define "nexus-page-toasts" {
    use "nexus-switch-card" symbol="powerplug" title="Charger" detail="Connected or unplugged." on="{var.toast-charging}" {
        on-click { set "toast-charging" "{!var.toast-charging}" }
    }
    use "nexus-switch-card" symbol="battery.25percent" title="Battery Warnings" detail="On battery, at 20, 10 and 5 %." on="{var.toast-battery}" {
        on-click { set "toast-battery" "{!var.toast-battery}" }
    }
    use "nexus-switch-card" symbol="hifispeaker" title="Audio Output" detail="A different output device is chosen." on="{var.toast-audio-output}" {
        on-click { set "toast-audio-output" "{!var.toast-audio-output}" }
    }
    use "nexus-switch-card" symbol="mic" title="Audio Input" detail="A different microphone is chosen." on="{var.toast-audio-input}" {
        on-click { set "toast-audio-input" "{!var.toast-audio-input}" }
    }
}

define "nexus-page-providers" {
    use "nexus-card" symbol="cloud.sun" title="Weather" detail="All without an account. The dashboard picks up a change the next time it opens." foot=#true {
        column class="nexus-options" {
            each source in="{var.nexus-weather}" key="{source.id}" {
                use "nexus-option" title="{source.title}" detail="{source.detail}" on="{source.id == var.weather-source}" { on-click { set "weather-source" "{source.id}" } }
            }
        }
    }
    use "nexus-card" symbol="folder" title="File Manager" detail="Stands at the top of the bar's Dock in Finder's place." foot=#true {
        column class="nexus-options" {
            use "nexus-option" title="Automatic" detail="Currently {apps.file-manager.name ?? 'Finder'}" on="{var.file-manager == null}" { on-click { set "file-manager" #null } }
            each app in="{apps.file-managers}" key="{app.bundle-id}" {
                use "nexus-option" title="{app.name}" on="{app.bundle-id == var.file-manager}" { on-click { set "file-manager" "{app.bundle-id}" } }
            }
            when "{var.file-manager != null && (apps.file-managers | where 'bundle-id' var.file-manager | count) == 0}" {
                use "nexus-option" title="{(apps.all | where 'bundle-id' var.file-manager | first).name ?? var.file-manager}" detail="{(apps.all | where 'bundle-id' var.file-manager | count) == 0 ? 'Not installed' : ''}" on=#true { }
            }
            row class="nexus-smalls nexus-options-foot" {
                use "nexus-small" title="Other App…" {
                    on-click {
                        close "nexus"
                        set "nexus-file-pick" ""
                        pick-file "nexus-file-pick"
                        when "{var.nexus-file-pick != '' && (apps.all | where 'path' var.nexus-file-pick | count) > 0}" { set "file-manager" "{(apps.all | where 'path' var.nexus-file-pick | first).bundle-id}" }
                    }
                }
            }
        }
    }
}

define "nexus-page-system" {
    use "nexus-switch-card" symbol="clock" title="Desktop Clock" detail="Bottom right, behind all windows." on="{var.desktop-clock}" {
        on-click { set "desktop-clock" "{!var.desktop-clock}" }
    }
    use "nexus-switch-card" symbol="dock.rectangle" title="Hide Apple's Dock" detail="While ApolloShell runs. It comes back when ApolloShell quits." on="{var.hide-apple-dock}" {
        on-click { set "hide-apple-dock" "{!var.hide-apple-dock}"; system.hide-apple-dock "{var.hide-apple-dock}" }
    }
    use "nexus-card" symbol="laptopcomputer" title="Keep Awake with the Lid Closed" detail="Needs your password once; ApolloShell then adds a rule for just this setting." foot="{power.lid-rule-installed == true}" {
        fill "side" {
            use "nexus-switch" on="{var.keep-awake-lid}" { on-click { set "keep-awake-lid" "{!var.keep-awake-lid}" } }
        }
        row class="nexus-smalls" {
            use "nexus-small" title="Remove Password-Free Rule…" { on-click { power.remove-lid-rule } }
        }
    }
    when "{shell.login-item != null}" {
        use "nexus-switch-card" symbol="power.circle" title="Start at Login" detail="{shell.login-item-note ?? 'Opens ApolloShell when you log in.'}" on="{shell.login-item}" disabled="{!shell.login-item-available}" {
            on-click { shell.set-login-item "{!shell.login-item}" }
        }
    }
    use "nexus-switch-card" symbol="menubar.rectangle" title="Show in Menu Bar" detail="Off hides this icon. Open ApolloShell again to bring it back." on="{var.nexus-shown}" {
        on-click { set "nexus-shown" "{!var.nexus-shown}" }
    }
    use "nexus-card" symbol="info.circle" title="ApolloShell" detail="{shell.version == null ? 'Version –' : 'Version ' + shell.version}" foot=#true {
        row class="nexus-smalls" {
            use "nexus-small" title="Introduction…" { on-click { close "nexus"; set "onboarding-step" 0; open "onboarding" } }
            use "nexus-small" title="System Settings" { on-click { close "nexus"; system.open-settings } }
            use "nexus-small" title="About" { on-click { close "nexus"; shell.about } }
        }
    }
}

define "nexus-page-updates" {
    when "{shell.update == null}" {
        use "nexus-card" symbol="arrow.triangle.2.circlepath" title="Updates" detail="Not available in launcher-only mode."
    }
    else {
        use "nexus-card" symbol="arrow.triangle.2.circlepath" title="{shell.update.status == 'available' ? 'Version ' + shell.update.version + ' available' : (shell.update.status == 'ready' ? 'Version ' + shell.update.version + ' ready to install' : var.nexus-update-text[shell.update.status])}" detail="{shell.update.last-check == null ? 'Not checked yet' : 'Last check ' + (shell.update.last-check | relative)}" foot=#true {
            row class="nexus-smalls" {
                when "{shell.update.status == 'ready'}" {
                    use "nexus-small" title="Restart to Update" prominent=#true { on-click { shell.install-update } }
                }
                use "nexus-small" title="Check Now" disabled="{shell.update.status == 'checking' || shell.update.status == 'unavailable'}" { on-click { shell.check-updates } }
                use "nexus-small" title="Release Notes" { on-click { close "nexus"; open-url "{shell.update.notes-url ?? 'https://github.com/Silvertree2010/ApolloShell/releases'}" } }
            }
        }
        use "nexus-switch-card" symbol="clock.arrow.circlepath" title="Check Automatically" detail="Once a day in the background." on="{shell.update.auto-check ?? true}" {
            on-click { shell.set-auto-check "{!(shell.update.auto-check ?? true)}" }
        }
        when "{shell.install-kind != 'homebrew'}" {
            use "nexus-switch-card" symbol="square.and.arrow.down" title="Install Automatically" detail="When you quit, so at the latest when you next log out." on="{shell.update.auto-install ?? true}" {
                on-click { shell.set-auto-install "{!(shell.update.auto-install ?? true)}" }
            }
        }
        else {
            use "nexus-card" symbol="mug" title="Homebrew" detail="brew upgrade apolloshell" foot=#true {
                row class="nexus-smalls" {
                    use "nexus-small" title="Copy Command" { on-click { clipboard.copy "brew upgrade apolloshell" } }
                }
            }
        }
    }
    use "nexus-card" symbol="ladybug" title="Crash Reports" detail="After a crash, ApolloShell can send the report to its developer: the ApolloShell and macOS versions, the Mac model and where in the code it crashed. No files, names or device IDs." foot=#true {
        column class="nexus-options" {
            use "nexus-option" title="Ask Each Time" on="{(shell.crash-reports ?? 'ask') == 'ask'}" { on-click { shell.set-crash-reports "ask" } }
            use "nexus-option" title="Always" on="{shell.crash-reports == 'always'}" { on-click { shell.set-crash-reports "always" } }
            use "nexus-option" title="Never" on="{shell.crash-reports == 'never'}" { on-click { shell.set-crash-reports "never" } }
        }
    }
}

status-item "nexus-item" visible="{var.nexus-shown}" {
    button id="nexus-mark" class="nexus-item" tooltip="ApolloShell" label="Nexus" {
        on-click { toggle "nexus" }
        on-right-click { command-center.open }
        icon "menubar-nexus" fallback="builtin:apollo-mark" class="nexus-mark"
    }
}

popup "nexus" attach="nexus-item#nexus-mark" side="bottom" align="center" offset-y=6 anchor="top" motion="fade" close-on="outside-click escape focus-loss" class="{theme.set['panel-fill'] ? 'themed' : 'bg-glass'}" {
    column class="nexus" {
        column class="nexus-top" {
            row class="nexus-tiles" {
                use "nexus-tile" title="Dashboard" symbol="square.grid.2x2.fill" lit="{var.feature-dashboard}" {
                    on-click { set "feature-dashboard" "{!var.feature-dashboard}"; emit "feature-dashboard" }
                }
                use "nexus-tile" title="Controls" label="Control Centre" symbol="slider.horizontal.3" lit="{var.feature-utilities}" {
                    on-click { set "feature-utilities" "{!var.feature-utilities}"; emit "feature-utilities" }
                }
                use "nexus-tile" title="Launcher" symbol="magnifyingglass" lit="{var.feature-launcher}" {
                    on-click { set "feature-launcher" "{!var.feature-launcher}" }
                }
                use "nexus-tile" title="Edit" symbol="pencil" toggle=#false disabled="{var.shell-editing}" {
                    on-click { close "nexus" wait=#true; use "edit-begin" }
                }
            }
            row class="nexus-tabs" {
                each tab in="{var.nexus-tabs}" key="{tab.id}" {
                    button class="nexus-tab" checked="{tab.id == var.nexus-tab}" tooltip="{tab.title}" label="{tab.title}" {
                        on-click { set "nexus-tab" "{tab.id}" }
                        icon "{tab.symbol}" class="nexus-tab-glyph"
                    }
                }
            }
        }
        scroll class="nexus-scroll" axis="vertical" {
            column class="nexus-page" {
                text "{((var.nexus-tabs | where 'id' var.nexus-tab | first).title ?? '') | upper}" class="nexus-page-title"
                column class="nexus-cards" {
                    use "nexus-page-{var.nexus-tab}"
                }
            }
        }
        row class="nexus-footer" {
            use "nexus-foot" title="Shortcuts…" symbol="keyboard" { on-click { close "nexus"; open "nexus-shortcuts" } }
            use "nexus-foot" title="Quit" symbol="power" { on-click { shell.quit } }
        }
    }
}

include "nexus-shortcuts.kdl"

style "nexus.css"

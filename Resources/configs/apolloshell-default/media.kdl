define "media-controls" {
    row class="media-controls" {
        button class="media-button" tooltip="Previous" {
            on-click { media.previous }
            icon "backward.fill" class="media-glyph"
        }
        button class="media-button media-play" tooltip="{media.playing ? 'Pause' : 'Play'}" {
            on-click { media.play-pause }
            icon "{media.playing ? 'pause.fill' : 'play.fill'}" class="media-glyph media-play-glyph"
        }
        button class="media-button" tooltip="Next" {
            on-click { media.next }
            icon "forward.fill" class="media-glyph"
        }
    }
}

define "dashboard-media" {
    stack class="media-tab" {
        image "{media.artwork}" fit="fill" class="media-backdrop"
        row class="media-now" {
            column class="media-cover-section" {
                stack class="media-artwork" {
                    icon "music.note" class="media-artwork-placeholder"
                    image "{media.artwork}" fit="fill" class="media-artwork-image"
                }
            }
            switch "{media.unavailable != null && media.unavailable != '' ? 'unavailable' : (media.playing || media.title != null ? 'playing' : 'idle')}" {
                case "unavailable" {
                    column class="media-empty" {
                        stack class="media-empty-badge" { icon "exclamationmark.triangle" class="media-empty-glyph" }
                        text "Media Not Available" class="media-empty-title"
                        text "The Now Playing adapter isn't running." class="media-empty-detail"
                    }
                }
                case "idle" {
                    column class="media-empty" {
                        stack class="media-empty-badge" { icon "music.note.list" class="media-empty-glyph" }
                        text "Nothing Playing" class="media-empty-title"
                        text "Play something, and it will appear here." class="media-empty-detail"
                    }
                }
                default {
                    row class="media-main" {
                        column class="media-info" {
                            text "{media.title}" class="media-title" lines=1 truncate="tail"
                            text "{media.artist ?? 'Unknown Artist'}" class="media-artist" lines=1 truncate="tail"
                            when "{media.album != null}" { text "{media.album}" class="media-album" lines=1 truncate="tail" }
                            row class="media-times" {
                                text "{(media.elapsed ?? 0) | duration 'clock'}" class="media-time"
                                progress value="{media.progress ?? 0}" class="media-timeline"
                                text "{media.duration != null ? '-' + ((media.duration - (media.elapsed ?? 0)) | duration 'clock') : '--:--'}" class="media-time"
                            }
                            use "media-controls"
                        }
                        column class="media-source-panel" {
                            row class="media-source-head" {
                                icon "hifispeaker.fill" class="media-source-head-glyph"
                                text "Source" class="media-source-head-title"
                            }
                            button class="media-source" {
                                on-click { media.open-app }
                                column class="media-source-body" {
                                    when "{media.app != null}" { app-icon "{media.app}" class="media-source-icon" }
                                    else { icon "app.dashed" class="media-source-fallback" }
                                    text "{media.app-name ?? 'Unknown App'}" class="media-source-name" lines=1
                                    row class="media-source-state" {
                                        icon "{media.playing ? 'waveform' : 'pause.fill'}" class="media-source-wave"
                                        text "{media.playing ? 'Playing' : 'Paused'}" class="media-source-state-text"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

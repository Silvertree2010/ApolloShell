var onboarding-step 0

var onboarding-features {
    - symbol="sidebar.left" tint="blue" title="Bar" text="Spaces, Dock, clock and status on the left edge"
    - symbol="magnifyingglass" tint="purple" title="Launcher" text="Search and open apps – with a keyboard shortcut"
    - symbol="square.grid.2x2.fill" tint="indigo" title="Dashboard" text="Weather, calendar, media and performance"
    - symbol="slider.horizontal.3" tint="green" title="Quick Actions" text="Keep Awake, sound and quick toggles, bottom right"
}

on "shell.started" when="{!var.onboarding-done}" { open "onboarding" }

define "onboarding-header" {
    param "symbol"
    param "tint"
    param "title"
    param "text"
    column class="onboarding-header" {
        stack class="onboarding-tile tile-{tint}" {
            icon "{symbol}" class="onboarding-tile-glyph"
        }
        text "{title}" class="onboarding-title"
        text "{text}" lines=0 class="onboarding-body"
    }
}

define "onboarding-permission" {
    param "title"
    param "detail"
    param "granted"
    param "kind"
    row class="onboarding-permission" {
        column class="onboarding-permission-text" {
            text "{title}" class="onboarding-permission-title"
            text "{detail}" class="onboarding-permission-detail"
        }
        spacer
        when "{granted}" {
            text "Granted" class="onboarding-granted"
        }
        else {
            button class="onboarding-grant" {
                on-click { permissions.open "{kind}" }
                text "Grant…"
            }
        }
    }
}

define "onboarding-access-row" {
    param "symbol"
    param "tint"
    param "title"
    param "detail"
    row class="onboarding-access" {
        stack class="onboarding-row-tile tile-{tint}" {
            icon "{symbol}" class="onboarding-row-tile-glyph"
        }
        column class="onboarding-access-text" {
            text "{title}" class="onboarding-access-title"
            text "{detail}" lines=0 class="onboarding-access-detail"
        }
        spacer class="onboarding-gap"
        slot
    }
}

window "onboarding" title="Welcome to ApolloShell" resizable=#false {
    on-close { set "onboarding-done" #true }
    column class="onboarding" {
        switch "{var.onboarding-step}" {
            case 0 {
                column class="onboarding-page" {
                    use "onboarding-header" symbol="sidebar.left" tint="indigo" title="Welcome to ApolloShell" text="A desktop shell for macOS modelled on Caelestia. It complements the Mac instead of replacing it – everything can be set up in Settings."
                    column class="onboarding-features" {
                        each feature in="{var.onboarding-features}" {
                            row class="onboarding-feature" {
                                icon "{feature.symbol}" class="onboarding-feature-glyph tint-{feature.tint}"
                                column class="onboarding-feature-text" {
                                    text "{feature.title}" class="onboarding-feature-title"
                                    text "{feature.text}" class="onboarding-feature-detail"
                                }
                            }
                        }
                    }
                }
            }
            case 1 {
                column class="onboarding-page onboarding-form" {
                    use "onboarding-header" symbol="hand.raised.fill" tint="blue" title="Permissions" text="Two permissions from macOS. Both can be revoked at any time under Privacy & Security."
                    column class="onboarding-cards" {
                        column class="onboarding-card" {
                            use "onboarding-access-row" symbol="accessibility" tint="blue" title="Accessibility" detail="So windows don't slide under the bar, the bar makes room in full screen, and the Dock knows an app's windows." {
                                when "{permissions.accessibility}" {
                                    row class="onboarding-status onboarding-status-granted" {
                                        icon "checkmark.circle.fill"
                                        text "Granted"
                                    }
                                }
                                else {
                                    button class="onboarding-access-grant" {
                                        on-click { permissions.open "accessibility" }
                                        text "Grant…"
                                    }
                                }
                            }
                            stack class="onboarding-divider"
                            use "onboarding-access-row" symbol="gearshape.2.fill" tint="gray" title="System Events" detail="For Log Out, Restart and Shut Down in the session menu. macOS asks by itself the first time – nothing to do now." {
                                row class="onboarding-status" {
                                    icon "clock"
                                    text "The first time"
                                }
                            }
                        }
                        text "Without Accessibility everything else still works; the bar then also stays visible in full screen, and windows can slide underneath it." lines=0 class="onboarding-footnote"
                    }
                }
            }
            case 2 {
                column class="onboarding-page onboarding-form" {
                    use "onboarding-header" symbol="command" tint="purple" title="Keyboard Shortcuts" text="The launcher opens with a shortcut, in any app. To change it, click the field and press the new combination."
                    column class="onboarding-cards" {
                        column class="onboarding-card" {
                            column class="onboarding-hotkey" {
                                row class="onboarding-hotkey-row" {
                                    stack class="onboarding-key-tile tile-purple" {
                                        icon "magnifyingglass" class="onboarding-key-tile-glyph"
                                    }
                                    column class="onboarding-hotkey-text" {
                                        text "Launcher" class="onboarding-hotkey-title"
                                        text "Search and open apps" class="onboarding-hotkey-detail"
                                    }
                                    spacer class="onboarding-gap"
                                    row class="onboarding-recorder-row" {
                                        key-recorder value="{var.hotkey-launcher}" placeholder="None" class="onboarding-recorder" {
                                            on-change { set "hotkey-launcher" "{event.chord}" }
                                        }
                                        button class="onboarding-clear {var.hotkey-launcher == '' ? 'empty' : ''}" {
                                            on-click { set "hotkey-launcher" "" }
                                            icon "xmark.circle.fill"
                                        }
                                    }
                                }
                                when "{(var.hotkey-launcher | hotkey-warning) != null}" {
                                    row class="onboarding-hotkey-warning" {
                                        icon "exclamationmark.triangle.fill"
                                        text "{var.hotkey-launcher | hotkey-warning}" lines=0
                                    }
                                }
                            }
                        }
                        column class="onboarding-card onboarding-shortcuts" {
                            row class="onboarding-shortcut" {
                                text "Dashboard"
                                spacer
                                text "{var.hotkey-dashboard | chord}" class="onboarding-shortcut-key"
                            }
                            row class="onboarding-shortcut" {
                                text "Quick Actions"
                                spacer
                                text "{var.hotkey-utilities | chord}" class="onboarding-shortcut-key"
                            }
                            row class="onboarding-shortcut" {
                                text "Settings"
                                spacer
                                text "{var.hotkey-settings | chord}" class="onboarding-shortcut-key"
                            }
                        }
                        text "Spotlight stays on ⌘Space. All shortcuts can be changed or removed in Settings under “Keyboard Shortcuts”." lines=0 class="onboarding-footnote"
                    }
                }
            }
            default {
                column class="onboarding-page onboarding-form" {
                    use "onboarding-header" symbol="checkmark" tint="green" title="All Set" text="Settings live in the Settings window, open it with {var.hotkey-settings | chord} or from the menu bar icon."
                    column class="onboarding-cards" {
                        row class="onboarding-card onboarding-login" {
                            column class="onboarding-hotkey-text" {
                                text "Start at Login" class="onboarding-login-title"
                                text "ApolloShell starts on its own after login" class="onboarding-hotkey-detail"
                            }
                            spacer class="onboarding-gap"
                            toggle checked="{shell.login-item}" disabled="{!shell.login-item-available}" {
                                on-change { shell.set-login-item "{event.value}" }
                            }
                        }
                        text "This introduction is always available again under Settings › About." lines=0 class="onboarding-footnote"
                    }
                }
            }
        }
        stack class="onboarding-footer" {
            row class="onboarding-actions" {
                when "{var.onboarding-step < 3}" {
                    button class="onboarding-skip" {
                        on-click { set "onboarding-done" #true; close "onboarding" }
                        text "Skip"
                    }
                }
                spacer
                when "{var.onboarding-step > 0}" {
                    button class="onboarding-back" {
                        on-click { set "onboarding-step" "{var.onboarding-step - 1}" }
                        text "Back"
                    }
                }
                button class="onboarding-next" {
                    on-click {
                        when "{var.onboarding-step < 3}" { set "onboarding-step" "{var.onboarding-step + 1}" }
                        else { set "onboarding-done" #true; close "onboarding" }
                    }
                    text "{['Get Started', 'Continue', 'Continue', 'Done'] | at var.onboarding-step}"
                }
            }
            row class="onboarding-dots" {
                each dot in="{[0, 1, 2, 3]}" {
                    stack class="onboarding-dot {dot == var.onboarding-step ? 'current' : ''}"
                }
            }
        }
    }
}

let sidebar-caelestia {
    - id="dashboard-button" kind="dashboard-button"
    - id="spaces" kind="spaces" style="dots"
    - id="dock" kind="dock" show-running=#true icon-size="medium"
    - id="clock" kind="clock" show-icon=#true show-date=#false
    - id="utilities-button" kind="utilities-button"
    - id="status-icons" kind="status-icons" wifi=#true bluetooth=#true battery=#true
    - id="power" kind="power"
}

let sidebar-minimal {
    - id="spaces" kind="spaces" style="dots"
    - id="spacer" kind="spacer"
    - id="clock" kind="clock" show-icon=#false show-date=#false
    - id="power" kind="power"
}

let sidebar-dock-only {
    - id="dock" kind="dock" show-running=#true icon-size="medium"
}

let sidebar-everything {
    - id="dashboard-button" kind="dashboard-button"
    - id="media-button" kind="media-button"
    - id="spaces" kind="spaces" style="dots"
    - id="divider" kind="divider"
    - id="dock" kind="dock" show-running=#true icon-size="medium"
    - id="divider-2" kind="divider"
    - id="app-button" kind="app-button" bundle-id="com.apple.systempreferences"
    - id="weather" kind="weather" show-temperature=#true
    - id="cpu" kind="cpu" style="ring"
    - id="battery" kind="battery" show-icon=#true
    - id="clock" kind="clock" show-icon=#true show-date=#false
    - id="utilities-button" kind="utilities-button"
    - id="status-icons" kind="status-icons" wifi=#true bluetooth=#true battery=#false
    - id="power" kind="power"
}

let dashboard-tabs-all {
    - id="dashboard" visible=#true
    - id="media" visible=#true
    - id="performance" visible=#true
    - id="weather" visible=#true
}

let dashboard-caelestia {
    tabs {
        - id="dashboard" visible=#true
        - id="media" visible=#true
        - id="performance" visible=#true
        - id="weather" visible=#true
    }
    top {
        - id="weather" kind="weather" show-condition=#true show-range=#true
        - id="user" kind="user" show-system=#true show-uptime=#true
    }
    bottom {
        - id="clock" kind="clock" style="stacked" show-date=#false
        - id="calendar" kind="calendar" first-weekday="monday" show-week-numbers=#false
        - id="resources" kind="resources" show-cpu=#true show-memory=#true show-storage=#true
    }
    side {
        - id="media" kind="media" show-album=#true show-source=#true
    }
}

let dashboard-compact {
    tabs {
        - id="dashboard" visible=#true
        - id="media" visible=#true
        - id="performance" visible=#true
        - id="weather" visible=#true
    }
    top {
        - id="weather" kind="weather" show-condition=#true show-range=#true
        - id="media" kind="media" show-album=#true show-source=#true
    }
    bottom {
        - id="clock" kind="clock" style="stacked" show-date=#false
        - id="calendar" kind="calendar" first-weekday="monday" show-week-numbers=#false
        - id="resources" kind="resources" show-cpu=#true show-memory=#true show-storage=#true
    }
    side "{[]}"
}

let dashboard-calendar-weather {
    tabs {
        - id="dashboard" visible=#true
        - id="weather" visible=#true
        - id="media" visible=#false
        - id="performance" visible=#false
    }
    top "{[]}"
    bottom {
        - id="clock" kind="clock" style="stacked" show-date=#false
        - id="calendar" kind="calendar" first-weekday="monday" show-week-numbers=#false
    }
    side {
        - id="weather" kind="weather" show-condition=#true show-range=#true
    }
}

let utilities-standard {
    cards {
        - kind="keep-awake" enabled=#true
        - kind="audio" enabled=#true
        - kind="quick-toggles" enabled=#true
    }
    toggles {
        - id="wifi" kind="wifi"
        - id="microphone" kind="microphone"
        - id="bluetooth" kind="bluetooth"
        - id="dark-mode" kind="dark-mode"
        - id="night-shift" kind="night-shift"
        - id="screenshot" kind="screenshot"
        - id="show-desktop" kind="show-desktop"
        - id="color-picker" kind="color-picker"
        - id="lock-screen" kind="lock-screen"
        - id="settings" kind="settings"
    }
}

let utilities-minimal {
    cards {
        - kind="quick-toggles" enabled=#true
        - kind="keep-awake" enabled=#false
        - kind="audio" enabled=#false
    }
    toggles {
        - id="wifi" kind="wifi"
        - id="bluetooth" kind="bluetooth"
        - id="dark-mode" kind="dark-mode"
        - id="lock-screen" kind="lock-screen"
        - id="settings" kind="settings"
    }
}

let utilities-audio {
    cards {
        - kind="audio" enabled=#true
        - kind="quick-toggles" enabled=#true
        - kind="keep-awake" enabled=#false
    }
    toggles {
        - id="microphone" kind="microphone"
        - id="bluetooth" kind="bluetooth"
        - id="wifi" kind="wifi"
        - id="display-sleep" kind="display-sleep"
        - id="settings" kind="settings"
    }
}

let utilities-everything {
    cards {
        - kind="keep-awake" enabled=#true
        - kind="audio" enabled=#true
        - kind="quick-toggles" enabled=#true
    }
    toggles {
        - id="wifi" kind="wifi"
        - id="microphone" kind="microphone"
        - id="bluetooth" kind="bluetooth"
        - id="dark-mode" kind="dark-mode"
        - id="night-shift" kind="night-shift"
        - id="screenshot" kind="screenshot"
        - id="show-desktop" kind="show-desktop"
        - id="color-picker" kind="color-picker"
        - id="lock-screen" kind="lock-screen"
        - id="display-sleep" kind="display-sleep"
        - id="hide-apps" kind="hide-apps" keep-frontmost=#false
        - id="settings" kind="settings"
    }
}

let hotkeys-default {
    launcher "alt+space"
    dashboard "ctrl+alt+d"
    utilities "ctrl+alt+u"
    settings "ctrl+alt+comma"
}
let hotkeys-hyper {
    launcher "f20"
    dashboard "hyper+d"
    utilities "hyper+u"
    settings "hyper+comma"
}

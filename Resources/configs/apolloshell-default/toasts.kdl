var toast-charging #true persist=#true
var toast-battery #true persist=#true
var toast-audio-output #true persist=#true
var toast-audio-input #true persist=#true

define "toast-card" {
    button class="toast-card kind-{toast.kind}" {
        on-click { toast.dismiss }
        row class="toast-row" {
            stack class="toast-chip" {
                icon "toast-{toast.kind}" fallback="{toast.icon != null ? toast.icon : (toast.kind == 'success' ? 'checkmark.circle.fill' : (toast.kind == 'warning' ? 'exclamationmark.triangle.fill' : (toast.kind == 'error' ? 'exclamationmark.circle.fill' : 'info.circle.fill')))}" class="toast-glyph"
            }
            column class="toast-text" {
                text "{toast.title}" class="toast-title" lines=1 truncate="tail"
                when "{toast.body != null && toast.body != ''}" {
                    text "{toast.body}" class="toast-body" lines=1 truncate="tail"
                }
            }
            spacer
        }
    }
}

toast "default" anchor="bottom-right" max=4 duration="5s" newest="last" click-through="auto" fullscreen="hide" offset-y="{surfaces.utilities.open ? surfaces.utilities.height + 12 : 0}" {
    use "toast-card"
}

on "timer.finished" {
    toast.show title="{event.mode == 'pomodoro' ? (event.phase == 'focus' ? 'Time for a Break' : 'Break Is Over') : 'Timer Done'}" body="{event.duration | ceil | duration}" kind="info" icon="timer"
    sound "Glass"
}
on "wallpaper.failed" { toast.show title="Wallpaper not set" body="{event.name}" kind="error" }
on "battery.charger-connected" when="{var.toast-charging}" { toast.show title="Charger Connected" body="Battery is charging" kind="info" icon="bolt.fill" }
on "battery.charger-disconnected" when="{var.toast-charging}" { toast.show title="Charger Unplugged" body="Battery is discharging" kind="info" icon="bolt.slash.fill" }
on "battery.warning" when="{var.toast-battery}" { toast.show title="{event.title}" body="{event.body}" kind="{event.critical ? 'error' : 'warning'}" icon="{event.critical ? 'minus.plus.batteryblock.exclamationmark.fill' : (event.level == '10' ? 'battery.0percent' : 'battery.25percent')}" }
on "audio.output-changed" when="{var.toast-audio-output}" { toast.show title="Audio Output Changed" body="Now using {event.name}" kind="info" icon="speaker.wave.2.fill" }
on "audio.input-changed" when="{var.toast-audio-input}" { toast.show title="Audio Input Changed" body="Now using {event.name}" kind="info" icon="mic.fill" }
on "power.keep-awake-stopped" { toast.show title="Keep Awake Ended" body="Battery is low" kind="warning" icon="battery.25percent" }
on "power.lid-still-awake" { toast.show title="Still Awake with Lid Closed" body="Turn Keep Awake on and off to try again" kind="warning" icon="laptopcomputer" }
on "system.color-copied" { toast.show title="Color Copied" body="{event.hex}" kind="info" icon="eyedropper" }
on "shortcuts.failed" { toast.show title="Shortcut Failed" body="{event.name}" kind="error" }

var toast-charging #true persist=#true
var toast-battery #true persist=#true
var toast-audio-output #true persist=#true
var toast-audio-input #true persist=#true

define "toast-card" {
    button class="toast-card kind-{toast.kind}" {
        on-click { toast.dismiss }
        row class="toast-row" {
            stack class="toast-chip" {
                icon "{toast.icon}" fallback="{toast.kind == 'success' ? 'checkmark.circle.fill' : (toast.kind == 'warning' ? 'exclamationmark.triangle.fill' : (toast.kind == 'error' ? 'xmark.octagon.fill' : 'info.circle.fill'))}" class="toast-glyph"
            }
            column class="toast-text" {
                text "{toast.title}" class="toast-title" lines=1 truncate="tail"
                when "{toast.body != null && toast.body != ''}" {
                    text "{toast.body}" class="toast-body" lines=1 truncate="tail"
                }
            }
            spacer
        }
    }
}

toast "default" anchor="bottom-right" max=4 duration="5s" newest="last" click-through="auto" fullscreen="hide" offset-y="{surfaces.utilities.open ? surfaces.utilities.height + 12 : 0}" {
    use "toast-card"
}

on "battery.charger-connected" when="{var.toast-charging}" { notify title="Charger Connected" body="Battery is charging" kind="info" icon="toast-info" }
on "battery.charger-disconnected" when="{var.toast-charging}" { notify title="Charger Unplugged" body="Battery is discharging" kind="info" icon="toast-info" }
on "battery.warning" when="{var.toast-battery}" { notify title="{event.title}" body="{event.body}" kind="{event.critical ? 'error' : 'warning'}" icon="{event.critical ? 'toast-error' : 'toast-warning'}" }
on "audio.output-changed" when="{var.toast-audio-output}" { notify title="Audio Output Changed" body="Now using {event.name}" kind="info" icon="toast-info" }
on "audio.input-changed" when="{var.toast-audio-input}" { notify title="Audio Input Changed" body="Now using {event.name}" kind="info" icon="toast-info" }
on "power.keep-awake-stopped" { notify title="Keep Awake Ended" body="Battery is low" kind="warning" icon="toast-warning" }
on "power.lid-still-awake" { notify title="Still Awake with Lid Closed" body="Turn Keep Awake on and off to try again" kind="warning" icon="toast-warning" }
on "system.color-copied" { notify title="Color Copied" body="{event.hex}" kind="success" icon="toast-success" }
on "shortcuts.failed" { notify title="Shortcut Failed" body="{event.name}" kind="error" icon="toast-error" }

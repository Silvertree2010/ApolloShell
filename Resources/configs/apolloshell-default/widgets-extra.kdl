style "widgets-extra.css"

define "wx-ring" {
    param "s"
    param "v"
    stack class="wx-ring" style="width: {s}px; height: {s}px" {
        ring value="{v}" class="wx-ring-fill" style="width: {s * 1.07}px; height: {s * 1.07}px; -apollo-stroke-width: {s * 0.07}px"
        stack class="wx-ring-inner" style="width: {s}px; height: {s}px; padding: {s * 0.14}px" { slot }
    }
}

define "wx-controls" {
    param "w"
    param "idle"
    param "own"
    param "mode"
    param "dur"
    param "d"
    row class="wx-controls" {
        when "{idle && mode == 'standard' && own}" {
            button class="wx-round" style="width: {d}px; height: {d}px; border-radius: {d / 2}px" {
                on-click { timer.set-mode "standard" "{(dur / 60 - 1) | max 1}" }
                icon "minus" class="wx-round-glyph" style="font-size: {d * 0.36}px"
            }
            button class="wx-round" style="width: {d}px; height: {d}px; border-radius: {d / 2}px" {
                on-click { timer.set-mode "standard" "{(dur / 60 + 1) | min 600}" }
                icon "plus" class="wx-round-glyph" style="font-size: {d * 0.36}px"
            }
        }
        else {
            button class="wx-round" style="width: {d}px; height: {d}px; border-radius: {d / 2}px" disabled="{idle}" {
                on-click { timer.reset }
                icon "arrow.counterclockwise" class="wx-round-glyph" style="font-size: {d * 0.36}px"
            }
        }
        button class="wx-play" style="width: {d * 1.6}px; height: {d}px; border-radius: {d / 2}px" {
            on-click {
                when "{idle && own == false}" { timer.set-mode "{w.display}" "{w.minutes ?? 10}" }
                when "{timer.running}" { timer.pause }
                else { timer.start }
            }
            icon "{timer.running ? 'pause.fill' : 'play.fill'}" class="wx-play-glyph" style="font-size: {d * 0.4}px"
        }
    }
}

define "widget-timer-body" {
    param "w"
    param "idle"
    param "own"
    param "mode"
    param "dur"
    param "text"
    param "value"
    param "symbol"
    param "label"
    when "{w.height < 150 && w.width < 200}" {
        button class="card wx-timer" {
            on-click {
                when "{idle && own == false}" { timer.set-mode "{w.display}" "{w.minutes ?? 10}" }
                when "{timer.running}" { timer.pause }
                else { timer.start }
            }
            use "wx-ring" s="{(w.height | min w.width) - 24}" v="{value}" {
                text "{text}" class="wx-digits" style="font-size: 20px" lines=1 min-scale=0.5
            }
        }
    }
    else {
        when "{w.height < 150}" {
            row class="card wx-timer row" {
                use "wx-ring" s="{(w.height - 32) | min 84}" v="{value}" {
                    icon "{symbol}" class="wx-glyph" style="font-size: 20px"
                }
                column class="wx-texts" {
                    text "{label}" class="wx-label" lines=1
                    text "{text}" class="wx-digits" style="font-size: 30px" lines=1 min-scale=0.6
                }
                spacer
                when "{w.width >= 280}" { use "wx-controls" w="{w}" idle="{idle}" own="{own}" mode="{mode}" dur="{dur}" d=34 }
            }
        }
        else {
            column class="card wx-timer col" {
                text "{label}" class="wx-label" lines=1
                use "wx-ring" s="{(w.width - 48) | min (w.height - 110) | min 220}" v="{value}" {
                    text "{text}" class="wx-digits" style="font-size: {((w.width - 48) | min (w.height - 110) | min 220) * 0.22}px" lines=1 min-scale=0.5
                }
                use "wx-controls" w="{w}" idle="{idle}" own="{own}" mode="{mode}" dur="{dur}" d=40
            }
        }
    }
}

define "widget-timer-view" {
    param "w"
    param "idle"
    param "own"
    param "mode"
    param "phase"
    param "el"
    param "dur"
    param "rem"
    use "widget-timer-body" w="{w}" idle="{idle}" own="{own}" mode="{mode}" dur="{dur}" text="{rem != null ? (rem | ceil | duration 'clock') : (el | floor | duration 'clock')}" value="{mode == 'stopwatch' ? (el % 60) / 60 : (dur > 0 ? 1 - ((el / dur) | min 1) : 0)}" symbol="{mode == 'standard' ? 'timer' : (mode == 'stopwatch' ? 'stopwatch' : (phase == 'focus' ? 'brain.head.profile' : 'cup.and.saucer.fill'))}" label="{mode == 'standard' ? 'Timer' : (mode == 'stopwatch' ? 'Stopwatch' : (phase == 'focus' ? 'Focus' : (phase == 'short-break' ? 'Short Break' : 'Long Break')))}"
}

define "widget-timer-length" {
    param "w"
    param "idle"
    param "own"
    param "mode"
    param "phase"
    param "el"
    param "prev"
    use "widget-timer-view" w="{w}" idle="{idle}" own="{own}" mode="{mode}" phase="{phase}" el="{el}" dur="{prev ? (mode == 'standard' ? (w.minutes ?? 10) * 60 : (mode == 'pomodoro' ? 1500 : null)) : timer.duration}" rem="{prev ? (mode == 'standard' ? (w.minutes ?? 10) * 60 : (mode == 'pomodoro' ? 1500 : null)) : timer.remaining}"
}

define "widget-timer" {
    param "w"
    use "widget-timer-length" w="{w}" idle="{timer.running == false && timer.elapsed == 0}" own="{timer.mode == w.display}" prev="{timer.running == false && timer.elapsed == 0 && timer.mode != w.display}" mode="{timer.running == false && timer.elapsed == 0 && timer.mode != w.display ? w.display : timer.mode}" phase="{timer.running == false && timer.elapsed == 0 && timer.mode != w.display ? 'focus' : timer.phase}" el="{timer.running == false && timer.elapsed == 0 && timer.mode != w.display ? 0 : timer.elapsed}"
}

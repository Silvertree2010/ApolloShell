var settings-file-manager-query ""
var settings-file-manager-other #false

var settings-weather-sources {
    - id="open-meteo" title="Open-Meteo" detail="Forecast for 7 days, hourly, worldwide. No account."
    - id="met-norway" title="MET Norway" detail="Norwegian Meteorological Institute, worldwide. No account."
    - id="wttr" title="wttr.in" detail="Compact forecast for 3 days. No account."
}

define "settings-choice" {
    param "title"
    param "detail" default=""
    param "checked"
    row class="settings-row settings-choice" {
        icon "{checked ? 'checkmark.circle.fill' : 'circle'}" class="settings-choice-glyph"
        column class="settings-row-text" {
            text "{title}" class="settings-row-title"
            when "{detail != ''}" { text "{detail}" class="settings-row-detail" lines=0 }
        }
        spacer
    }
}

define "settings-page-providers" {
    column class="settings-group" {
        text "Weather" class="settings-group-title"
        each source in="{var.settings-weather-sources}" key="{source.id}" {
            button class="settings-choice-button" checked="{source.id == var.weather-source}" {
                on-click { set "weather-source" "{source.id}" }
                use "settings-choice" title="{source.title}" detail="{source.detail}" checked="{source.id == var.weather-source}"
            }
        }
        when "{weather.attribution != null}" {
            button class="settings-link-row" {
                on-click { open-url "{weather.attribution.url}" }
                text "{weather.attribution.text}" class="settings-row-detail"
            }
        }
    }
    column class="settings-group" {
        text "File Manager" class="settings-group-title"
        button class="settings-choice-button" checked="{var.file-manager == null}" {
            on-click { set "file-manager" #null }
            use "settings-choice" title="Automatic" detail="Currently {apps.file-manager.name}" checked="{var.file-manager == null}"
        }
        each app in="{apps.file-managers}" key="{app.bundle-id}" {
            button class="settings-choice-button" checked="{app.bundle-id == var.file-manager}" {
                on-click { set "file-manager" "{app.bundle-id}" }
                row class="settings-row" {
                    app-icon "{app.bundle-id}" class="settings-app-icon"
                    use "settings-choice" title="{app.name}" checked="{app.bundle-id == var.file-manager}"
                }
            }
        }
        when "{var.file-manager != null && (apps.file-managers | where 'bundle-id' var.file-manager | count) == 0}" {
            use "settings-choice" title="{(apps.all | where 'bundle-id' var.file-manager | first).name ?? var.file-manager}" checked=#true
        }
        button class="settings-disclosure" checked="{var.settings-file-manager-other}" {
            on-click { toggle-var "settings-file-manager-other" }
            row class="button-content" {
                icon "{var.settings-file-manager-other ? 'chevron.down' : 'chevron.right'}" class="settings-disclosure-glyph"
                text "Other App…" class="settings-row-title"
            }
        }
        when "{var.settings-file-manager-other}" {
            input bind="var.settings-file-manager-query" placeholder="Search Apps" class="settings-search"
            each app in="{apps.all | fuzzy var.settings-file-manager-query | take 8}" key="{app.bundle-id}" {
                button class="settings-row settings-result" {
                    on-click { set "file-manager" "{app.bundle-id}"; set "settings-file-manager-other" #false; set "settings-file-manager-query" "" }
                    row class="button-content" {
                        app-icon "{app.bundle-id}" class="settings-app-icon"
                        text "{app.name}" class="settings-row-title"
                    }
                }
            }
        }
    }
}

var settings-toggle-selected ""
var settings-toggle-title ""
var settings-toggle-url ""
var settings-toggle-symbol ""
var settings-toggle-query ""
var settings-toggle-gallery #false
var settings-toggle-symbols-open #false
var settings-utilities-confirm ""

var utilities-card-kinds {
    - kind="keep-awake" title="Keep Awake" summary="Keep the Mac awake, even with the lid closed if you want." symbol="cup.and.saucer.fill"
    - kind="audio" title="Sound" summary="Volume, mute, output and input." symbol="speaker.wave.2.fill"
    - kind="quick-toggles" title="Quick Toggles" summary="Switches and actions, five per row." symbol="square.grid.3x3.fill"
}

var utilities-toggle-groups {
    - id="custom" title="Custom Buttons"
    - id="actions" title="Actions"
    - id="switches" title="Switches"
}

var utilities-toggle-kinds {
    - kind="wifi" group="switches" title="Wi-Fi" summary="Turn Wi-Fi on and off." symbol="wifi" unique=#true {
        toggle id="wifi" kind="wifi"
    }
    - kind="microphone" group="switches" title="Microphone" summary="Mute the default microphone." symbol="mic.fill" unique=#true {
        toggle id="microphone" kind="microphone"
    }
    - kind="bluetooth" group="switches" title="Bluetooth" summary="Shows the state, a click opens Settings." symbol="builtin:bluetooth-rune" unique=#true {
        toggle id="bluetooth" kind="bluetooth"
    }
    - kind="dark-mode" group="switches" title="Dark Mode" summary="Switch between light and dark." symbol="circle.lefthalf.filled" unique=#true {
        toggle id="dark-mode" kind="dark-mode"
    }
    - kind="night-shift" group="switches" title="Night Shift" summary="Warmer colors in the evening." symbol="sunset.fill" unique=#true {
        toggle id="night-shift" kind="night-shift"
    }
    - kind="screenshot" group="actions" title="Screenshot" summary="Apple's bar for screenshot and recording." symbol="camera.viewfinder" unique=#true {
        toggle id="screenshot" kind="screenshot"
    }
    - kind="show-desktop" group="actions" title="Desktop" summary="All windows aside, the desktop clear." symbol="desktopcomputer" unique=#true {
        toggle id="show-desktop" kind="show-desktop"
    }
    - kind="color-picker" group="actions" title="Color Picker" summary="Color from the screen, hex value to the clipboard." symbol="eyedropper" unique=#true {
        toggle id="color-picker" kind="color-picker"
    }
    - kind="lock-screen" group="actions" title="Lock Screen" summary="Lock the screen." symbol="lock.fill" unique=#true {
        toggle id="lock-screen" kind="lock-screen"
    }
    - kind="settings" group="actions" title="Settings" summary="Opens Settings." symbol="gearshape.fill" unique=#true {
        toggle id="settings" kind="settings"
    }
    - kind="display-sleep" group="actions" title="Display Off" summary="Turns off the displays immediately, the Mac keeps running." symbol="moon.zzz.fill" unique=#true {
        toggle id="display-sleep" kind="display-sleep"
    }
    - kind="hide-apps" group="actions" title="Hide Apps" summary="Hides all apps; the frontmost one can stay if you want." symbol="eye.slash.fill" unique=#true {
        toggle id="hide-apps" kind="hide-apps" keep-frontmost=#false
    }
    - kind="open-app" group="custom" title="Open App" summary="Launches a chosen app or brings it to the front." symbol="app.fill" unique=#false {
        toggle kind="open-app" bundle-id=""
    }
    - kind="open-link" group="custom" title="Open Link" summary="Opens an address in the default browser." symbol="link" unique=#false {
        toggle kind="open-link" url=""
    }
    - kind="run-shortcut" group="custom" title="Shortcut" summary="Runs a shortcut, e.g. to toggle a Focus." symbol="square.2.layers.3d.fill" unique=#false {
        toggle kind="run-shortcut" name=""
    }
}

var utilities-presets {
    - id="standard" title="Standard" summary="The default: Keep Awake, Sound and ten quick toggles."
    - id="minimal" title="Minimal" summary="Just one row of quick toggles, no cards above."
    - id="audio" title="Sound & Devices" summary="Sound at the top, below that microphone, Bluetooth and what you need while listening."
    - id="everything" title="Everything" summary="Every card and every fixed button once, for trying out and sorting through."
}

var utilities-symbol-choices {
    - "app.fill"
    - "link"
    - "globe"
    - "square.2.layers.3d.fill"
    - "star.fill"
    - "heart.fill"
    - "bolt.fill"
    - "moon.fill"
    - "sun.max.fill"
    - "bell.fill"
    - "bell.slash.fill"
    - "music.note"
    - "play.fill"
    - "headphones"
    - "house.fill"
    - "envelope.fill"
    - "message.fill"
    - "calendar"
    - "note.text"
    - "checklist"
    - "book.fill"
    - "doc.fill"
    - "folder.fill"
    - "terminal.fill"
    - "hammer.fill"
    - "paintbrush.fill"
    - "camera.fill"
    - "photo.fill"
    - "film.fill"
    - "gamecontroller.fill"
    - "cup.and.saucer.fill"
    - "lightbulb.fill"
    - "timer"
    - "alarm.fill"
    - "flag.fill"
    - "bookmark.fill"
    - "cart.fill"
    - "briefcase.fill"
    - "chart.bar.fill"
    - "keyboard.fill"
    - "printer.fill"
    - "network"
    - "server.rack"
    - "key.fill"
    - "sparkles"
    - "wand.and.stars"
    - "leaf.fill"
    - "airplane"
}

define "settings-toggle-options" {
    param "toggle"
    param "look"
    column class="settings-group settings-options" {
        row class="settings-row" {
            icon "{toggle.symbol != null && toggle.symbol != '' ? toggle.symbol : look.symbol}" class="settings-row-glyph"
            text "{look.title}" class="settings-group-title"
            spacer
            button class="settings-button" {
                on-click { list.remove "utilities-toggles" key="{toggle.id}"; set "settings-toggle-selected" "" }
                text "Remove"
            }
        }
        switch "{toggle.kind}" {
            case "hide-apps" {
                use "settings-switch" title="Leave Frontmost App" detail="The app you are working in stays visible." checked="{toggle.keep-frontmost ?? false}" {
                    on-change { list.update "utilities-toggles" key="{toggle.id}" { - keep-frontmost="{event.value}" } }
                }
            }
            case "open-app" {
                row class="settings-row" {
                    text "App" class="settings-row-title"
                    spacer
                    when "{(toggle.bundle-id ?? '') != ''}" { app-icon "{toggle.bundle-id}" class="settings-app-icon" }
                    text "{(toggle.bundle-id ?? '') == '' ? 'No App Chosen Yet' : ((apps.all | where 'bundle-id' toggle.bundle-id | first).name ?? toggle.bundle-id)}" class="settings-row-value"
                }
                input bind="var.settings-toggle-query" placeholder="Search Apps" class="settings-search"
                when "{var.settings-toggle-query != ''}" {
                    each app in="{apps.all | fuzzy var.settings-toggle-query | take 8}" key="{app.bundle-id}" {
                        button class="settings-row settings-result" checked="{app.bundle-id == toggle.bundle-id}" {
                            on-click { list.update "utilities-toggles" key="{toggle.id}" { - bundle-id="{app.bundle-id}" }; set "settings-toggle-query" "" }
                            row class="button-content" {
                                app-icon "{app.bundle-id}" class="settings-app-icon"
                                text "{app.name}" class="settings-row-title"
                            }
                        }
                    }
                }
            }
            case "open-link" {
                row class="settings-row" {
                    text "Address" class="settings-row-title"
                    input bind="var.settings-toggle-url" placeholder="example.com" class="settings-search settings-field" {
                        on-submit { list.update "utilities-toggles" key="{toggle.id}" { - url="{var.settings-toggle-url}" } }
                    }
                }
                when "{var.settings-toggle-url != '' && (var.settings-toggle-url | url) == null}" {
                    text "Not a valid address." class="settings-warning"
                }
            }
            case "run-shortcut" {
                row class="settings-row" {
                    text "Shortcut" class="settings-row-title"
                    spacer
                    text "{(toggle.name ?? '') == '' ? 'No Shortcut Chosen Yet' : toggle.name}" class="settings-row-value"
                }
                input bind="var.settings-toggle-query" placeholder="Search Shortcuts" class="settings-search"
                each shortcut in="{var.settings-toggle-query == '' ? (shortcuts.list | take 8) : (shortcuts.list | fuzzy var.settings-toggle-query 'name' | take 8)}" key="{shortcut.id}" {
                    button class="settings-row settings-result" checked="{shortcut.name == toggle.name}" {
                        on-click { list.update "utilities-toggles" key="{toggle.id}" { - name="{shortcut.name}" identifier="{shortcut.id}" }; set "settings-toggle-query" "" }
                        row class="button-content" {
                            text "{shortcut.name}" class="settings-row-title"
                            spacer
                            when "{shortcut.name == toggle.name}" { icon "checkmark" class="settings-choice-glyph" }
                        }
                    }
                }
            }
        }
        when "{toggle.kind == 'open-app' || toggle.kind == 'open-link' || toggle.kind == 'run-shortcut'}" {
            row class="settings-row" {
                text "Title" class="settings-row-title"
                input bind="var.settings-toggle-title" placeholder="Automatic" class="settings-search settings-field" {
                    on-submit { list.update "utilities-toggles" key="{toggle.id}" { - title="{var.settings-toggle-title}" } }
                }
            }
            row class="settings-row" {
                text "Symbol" class="settings-row-title"
                spacer
                button class="settings-popup-button" checked="{var.settings-toggle-symbols-open}" {
                    on-click { toggle-var "settings-toggle-symbols-open" }
                    row class="button-content" {
                        icon "{toggle.symbol != null && toggle.symbol != '' ? toggle.symbol : look.symbol}"
                        text "{toggle.symbol != null && toggle.symbol != '' ? 'Custom' : 'Automatic'}"
                    }
                }
            }
            when "{var.settings-toggle-symbols-open}" {
                column class="settings-symbol-picker" {
                    button class="settings-choice-button" checked="{toggle.symbol == null || toggle.symbol == ''}" {
                        on-click { list.update "utilities-toggles" key="{toggle.id}" { - symbol="" }; set "settings-toggle-symbol" ""; set "settings-toggle-symbols-open" #false }
                        use "settings-choice" title="Automatic" checked="{toggle.symbol == null || toggle.symbol == ''}"
                    }
                    grid columns=8 class="settings-symbol-grid" {
                        each symbol in="{var.utilities-symbol-choices}" key="{symbol}" {
                            when "{symbol | symbol-exists}" {
                                button class="settings-symbol" checked="{symbol == toggle.symbol}" tooltip="{symbol}" {
                                    on-click { list.update "utilities-toggles" key="{toggle.id}" { - symbol="{symbol}" }; set "settings-toggle-symbol" "{symbol}"; set "settings-toggle-symbols-open" #false }
                                    icon "{symbol}"
                                }
                            }
                        }
                    }
                    row class="settings-row" {
                        input bind="var.settings-toggle-symbol" placeholder="SF Symbol Name" class="settings-search settings-field" {
                            on-submit {
                                when "{var.settings-toggle-symbol | symbol-exists}" { list.update "utilities-toggles" key="{toggle.id}" { - symbol="{var.settings-toggle-symbol}" }; set "settings-toggle-symbols-open" #false }
                            }
                        }
                        button class="settings-button" disabled="{!(var.settings-toggle-symbol | symbol-exists)}" {
                            on-click { list.update "utilities-toggles" key="{toggle.id}" { - symbol="{var.settings-toggle-symbol}" }; set "settings-toggle-symbols-open" #false }
                            text "Apply"
                        }
                    }
                }
            }
        }
    }
}

define "settings-page-control-centre" {
    column class="settings-group" {
        text "Cards" class="settings-group-title"
        reorderable axis="vertical" enabled=#true {
            on-reorder { list.move "utilities-cards" from="{event.from}" to="{event.to}" }
            each card in="{var.utilities-cards}" key="{card.kind}" index="i" {
                row class="settings-row settings-module-row" {
                    menu {
                        item "Move Up" disabled="{i == 0}" { list.move "utilities-cards" from="{i}" to="{i - 1}" }
                        item "Move Down" disabled="{i == (var.utilities-cards | count) - 1}" { list.move "utilities-cards" from="{i}" to="{i + 2}" }
                    }
                    accessibility-action "Move Up" { list.move "utilities-cards" from="{i}" to="{i - 1}" }
                    accessibility-action "Move Down" { list.move "utilities-cards" from="{i}" to="{i + 2}" }
                    icon "{(var.utilities-card-kinds | where 'kind' card.kind | first).symbol}" class="settings-row-glyph"
                    column class="settings-row-text" {
                        text "{(var.utilities-card-kinds | where 'kind' card.kind | first).title ?? card.kind}" class="settings-row-title"
                        text "{(var.utilities-card-kinds | where 'kind' card.kind | first).summary ?? ''}" class="settings-row-detail" lines=0
                    }
                    spacer
                    toggle checked="{card.enabled}" class="settings-switch" {
                        on-change { list.update "utilities-cards" at="{i}" { - enabled="{event.value}" } }
                    }
                }
            }
        }
    }
    column class="settings-group" {
        text "Keep Awake" class="settings-group-title"
        use "settings-switch" title="Also With the Lid Closed" detail="The Mac stays awake with the lid closed too. Asked again each time you turn Keep Awake on, and applies right away." checked="{var.keep-awake-lid}" {
            on-change { set "keep-awake-lid" "{event.value}" }
        }
        when "{power.lid-rule-installed}" {
            row class="settings-row" {
                column class="settings-row-text" {
                    text "Password-Free Rule" class="settings-row-title"
                    text "A rule in /etc/sudoers.d lets ApolloShell switch sleep with the lid closed without asking for your password." class="settings-row-detail" lines=0
                }
                spacer
                button class="settings-button" {
                    on-click { power.remove-lid-rule }
                    text "Remove…"
                }
            }
        }
    }
    column class="settings-group" {
        text "Quick Toggles" class="settings-group-title"
        text "Five per row. Drag a button onto the place of another, click one to edit it." class="settings-row-detail" lines=0
        reorderable axis="grid" enabled=#true class="settings-toggle-grid" {
            on-reorder { list.move "utilities-toggles" from="{event.from}" to="{event.to}" }
            each toggle in="{var.utilities-toggles}" key="{toggle.id}" index="i" {
                button class="settings-toggle-tile" checked="{toggle.id == var.settings-toggle-selected}" tooltip="{(var.utilities-toggle-kinds | where 'kind' toggle.kind | first).title ?? toggle.kind}" {
                    on-click { set "settings-toggle-selected" "{toggle.id}"; set "settings-toggle-title" "{toggle.title ?? ''}"; set "settings-toggle-url" "{toggle.url ?? ''}"; set "settings-toggle-symbol" "{toggle.symbol ?? ''}"; set "settings-toggle-query" ""; set "settings-toggle-symbols-open" #false }
                    menu {
                        item "Move Forward" disabled="{i == 0}" { list.move "utilities-toggles" from="{i}" to="{i - 1}" }
                        item "Move Backward" disabled="{i == (var.utilities-toggles | count) - 1}" { list.move "utilities-toggles" from="{i}" to="{i + 2}" }
                        separator
                        item "Remove" { list.remove "utilities-toggles" key="{toggle.id}" }
                    }
                    accessibility-action "Move Forward" { list.move "utilities-toggles" from="{i}" to="{i - 1}" }
                    accessibility-action "Move Backward" { list.move "utilities-toggles" from="{i}" to="{i + 2}" }
                    column class="settings-toggle-content" {
                        icon "{toggle.symbol != null && toggle.symbol != '' ? toggle.symbol : (var.utilities-toggle-kinds | where 'kind' toggle.kind | first).symbol}" class="settings-toggle-glyph"
                        text "{toggle.title != null && toggle.title != '' ? toggle.title : (var.utilities-toggle-kinds | where 'kind' toggle.kind | first).title}" class="settings-toggle-title" lines=1 truncate="tail"
                    }
                }
            }
        }
        row class="settings-actions" {
            button class="settings-button" checked="{var.settings-toggle-gallery}" {
                on-click { toggle-var "settings-toggle-gallery" }
                row class="button-content" {
                    icon "plus"
                    text "Add Button…"
                }
            }
            spacer
            button class="settings-button" menu-on="click" {
                menu side="below" {
                    each preset in="{var.utilities-presets}" key="{preset.id}" {
                        item "{preset.title}" { set "settings-utilities-confirm" "{preset.id}"; open "settings-confirm" }
                    }
                }
                text "Load Preset…"
            }
            button class="settings-button" disabled="{var.utilities-cards == var.utilities-standard.cards && var.utilities-toggles == var.utilities-standard.toggles}" {
                on-click { set "settings-utilities-confirm" "reset"; open "settings-confirm" }
                text "Reset"
            }
        }
    }
    when "{var.settings-toggle-gallery}" {
        column class="settings-group" {
            text "Add Button" class="settings-group-title"
            each group in="{var.utilities-toggle-groups}" key="{group.id}" {
                text "{group.title}" class="settings-row-title"
                grid columns=3 class="settings-gallery" {
                    each kind in="{var.utilities-toggle-kinds | where 'group' group.id}" key="{kind.kind}" {
                        button class="settings-gallery-tile" disabled="{kind.unique && (var.utilities-toggles | where 'kind' kind.kind | count) > 0}" tooltip="{kind.unique && (var.utilities-toggles | where 'kind' kind.kind | count) > 0 ? 'Only exists once, and it is already in the grid' : 'Add ' + kind.title}" {
                            on-click {
                                list.insert "utilities-toggles" id-from="kind" { - "{kind.toggle}" }
                                set "settings-toggle-gallery" #false
                            }
                            column class="settings-gallery-content" {
                                icon "{kind.symbol}" class="settings-gallery-glyph"
                                text "{kind.title}" class="settings-row-title"
                                text "{kind.summary}" class="settings-row-detail" lines=0
                                when "{kind.unique && (var.utilities-toggles | where 'kind' kind.kind | count) > 0}" {
                                    text "Already Added" class="settings-badge"
                                }
                            }
                        }
                    }
                }
            }
            row class="settings-actions" {
                spacer
                button class="settings-button" {
                    on-click { set "settings-toggle-gallery" #false }
                    text "Cancel"
                }
            }
        }
    }
    when "{var.settings-toggle-selected != '' && (var.utilities-toggles | where 'id' var.settings-toggle-selected | count) > 0}" {
        use "settings-toggle-options" toggle="{var.utilities-toggles | where 'id' var.settings-toggle-selected | first}" look="{var.utilities-toggle-kinds | where 'kind' (var.utilities-toggles | where 'id' var.settings-toggle-selected | first).kind | first}"
    }
}

define "settings-confirm-control-centre" {
    column class="settings-confirm" {
        text "{var.settings-utilities-confirm == 'reset' ? 'Reset the Control Centre?' : 'Load preset “' + (var.utilities-presets | where 'id' var.settings-utilities-confirm | first).title + '”?'}" class="settings-row-title"
        text "{var.settings-utilities-confirm == 'reset' ? 'Cards and buttons like they were at the start again (Standard preset).' : (var.utilities-presets | where 'id' var.settings-utilities-confirm | first).summary} The current arrangement will be replaced." class="settings-row-detail" lines=0
        row class="settings-actions" {
            spacer
            button class="settings-button" {
                on-click { close "settings-confirm" }
                text "Cancel"
            }
            button class="settings-button settings-default-button" {
                on-click {
                    switch "{var.settings-utilities-confirm}" {
                        case "minimal" { set "utilities-cards" "{var.utilities-minimal.cards}"; set "utilities-toggles" "{var.utilities-minimal.toggles}" }
                        case "audio" { set "utilities-cards" "{var.utilities-audio.cards}"; set "utilities-toggles" "{var.utilities-audio.toggles}" }
                        case "everything" { set "utilities-cards" "{var.utilities-everything.cards}"; set "utilities-toggles" "{var.utilities-everything.toggles}" }
                        default { set "utilities-cards" "{var.utilities-standard.cards}"; set "utilities-toggles" "{var.utilities-standard.toggles}" }
                    }
                    close "settings-confirm"
                    set "settings-toggle-selected" ""
                }
                text "{var.settings-utilities-confirm == 'reset' ? 'Reset' : 'Load'}"
            }
        }
    }
}

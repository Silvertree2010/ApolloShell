let settings-system-groups {
    - title="Style" {
        panes {
            - title="Wallpaper" area="wallpaper" symbol="photo"
            - title="Appearance" area="appearance" symbol="circle.lefthalf.filled"
        }
    }
    - title="Connectivity" {
        panes {
            - title="Network" area="network" symbol="network"
            - title="Connected Devices" area="bluetooth" symbol="antenna.radiowaves.left.and.right"
            - title="Sound" area="sound" symbol="speaker.wave.2.fill"
        }
    }
    - title="System" {
        panes {
            - title="Software Update" area="software-update" symbol="gear.badge"
            - title="Language & Region" area="language-region" symbol="globe"
        }
    }
}

define "settings-page-system-settings" {
    each group in="{settings-system-groups}" key="{group.title}" {
        column class="settings-group" {
            text "{group.title}" class="settings-group-title"
            each pane in="{group.panes}" key="{pane.area}" {
                button class="settings-row settings-link-row" {
                    on-click { system.open-settings "{pane.area}" }
                    icon "{pane.symbol}" class="settings-row-glyph"
                    text "{pane.title}" class="settings-row-title"
                    spacer
                    icon "arrow.up.forward.app" class="settings-link-glyph"
                }
            }
        }
    }
    row class="settings-actions" {
        button class="settings-button" {
            on-click { system.open-settings }
            text "Open System Settings"
        }
    }
}

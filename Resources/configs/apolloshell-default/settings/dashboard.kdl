var settings-weather-query ""
var settings-dashboard-rename ""

define "settings-page-dashboard" {
    column class="settings-group" {
        text "Pages" class="settings-group-title"
        text "The order here is the order in the Dashboard, left to right. Widgets are placed in Edit Interface." class="settings-row-detail" lines=0
        reorderable axis="vertical" enabled=#true {
            on-reorder { list.move "dashboard-pages" from="{event.from}" to="{event.to}" }
            each page in="{var.dashboard-pages}" key="{page.id}" index="i" {
                row class="settings-row settings-module-row" {
                    menu {
                        item "Move Left" disabled="{i == 0}" { list.move "dashboard-pages" from="{i}" to="{i - 1}" }
                        item "Move Right" disabled="{i == (var.dashboard-pages | count) - 1}" { list.move "dashboard-pages" from="{i}" to="{i + 2}" }
                        separator
                        item "Delete" disabled="{(var.dashboard-pages | count) <= 1}" {
                            set "dashboard-widgets" "{var.dashboard-widgets | where-not 'page' page.id}"
                            list.remove "dashboard-pages" key="{page.id}"
                        }
                    }
                    accessibility-action "Move Left" { list.move "dashboard-pages" from="{i}" to="{i - 1}" }
                    accessibility-action "Move Right" { list.move "dashboard-pages" from="{i}" to="{i + 2}" }
                    icon "{page.symbol}" class="settings-row-glyph"
                    column class="settings-row-text" {
                        text "{page.name}" class="settings-row-title"
                        text "{(var.dashboard-widgets | where 'page' page.id | count) == 1 ? '1 widget' : (var.dashboard-widgets | where 'page' page.id | count) + ' widgets'}" class="settings-row-detail"
                    }
                    spacer
                    button class="settings-icon-button" tooltip="Delete" disabled="{(var.dashboard-pages | count) <= 1}" {
                        on-click {
                            set "dashboard-widgets" "{var.dashboard-widgets | where-not 'page' page.id}"
                            list.remove "dashboard-pages" key="{page.id}"
                        }
                        icon "minus.circle.fill"
                    }
                }
            }
        }
        row class="settings-actions" {
            button class="settings-button" {
                on-click {
                    list.insert "dashboard-pages" { - id="page-{clock.now | date 'yyyyMMddHHmmssSSS'}" name="Page {(var.dashboard-pages | count) + 1}" symbol="square.grid.2x2" }
                }
                row class="button-content" {
                    icon "plus"
                    text "New Page"
                }
            }
            button class="settings-button" disabled="{(var.dashboard-pages | where 'id' 'dashboard' | count) > 0 && (var.dashboard-pages | where 'id' 'media' | count) > 0 && (var.dashboard-pages | where 'id' 'performance' | count) > 0 && (var.dashboard-pages | where 'id' 'weather' | count) > 0}" {
                on-click {
                    when "{(var.dashboard-pages | where 'id' 'dashboard' | count) == 0}" {
                        set "dashboard-pages" "{var.dashboard-pages | concat (var.dashboard-default-pages | where 'id' 'dashboard')}"
                        set "dashboard-widgets" "{(var.dashboard-widgets | where-not 'page' 'dashboard' | concat (var.dashboard-default-widgets | where 'page' 'dashboard'))}"
                    }
                    when "{(var.dashboard-pages | where 'id' 'media' | count) == 0}" {
                        set "dashboard-pages" "{var.dashboard-pages | concat (var.dashboard-default-pages | where 'id' 'media')}"
                        set "dashboard-widgets" "{(var.dashboard-widgets | where-not 'page' 'media' | concat (var.dashboard-default-widgets | where 'page' 'media'))}"
                    }
                    when "{(var.dashboard-pages | where 'id' 'performance' | count) == 0}" {
                        set "dashboard-pages" "{var.dashboard-pages | concat (var.dashboard-default-pages | where 'id' 'performance')}"
                        set "dashboard-widgets" "{(var.dashboard-widgets | where-not 'page' 'performance' | concat (var.dashboard-default-widgets | where 'page' 'performance'))}"
                    }
                    when "{(var.dashboard-pages | where 'id' 'weather' | count) == 0}" {
                        set "dashboard-pages" "{var.dashboard-pages | concat (var.dashboard-default-pages | where 'id' 'weather')}"
                        set "dashboard-widgets" "{(var.dashboard-widgets | where-not 'page' 'weather' | concat (var.dashboard-default-widgets | where 'page' 'weather'))}"
                    }
                }
                text "Restore Default Pages"
            }
            spacer
            button class="settings-button" {
                on-click { close "settings"; use "edit-begin" }
                text "Edit Interface…"
            }
        }
    }
    column class="settings-group" {
        text "Size" class="settings-group-title"
        row class="settings-row" {
            column class="settings-row-text" {
                text "Dashboard Size" class="settings-row-title"
                text "Grows with the screen; this factor comes on top." class="settings-row-detail"
            }
            spacer
            slider value="{var.dashboard-scale}" min=0.7 max=1.5 step=0.05 class="settings-slider" label="Dashboard Size" {
                on-change { set "dashboard-scale" "{event.value}" }
            }
            text "{var.dashboard-scale * 100 | round}%" class="settings-row-detail"
        }
    }
    column class="settings-group" {
        text "Favorites" class="settings-group-title"
        when "{(var.weather-places | count) == 0}" {
            text "No places yet. Search for one below." class="settings-row-detail"
        }
        reorderable axis="vertical" enabled=#true {
            on-reorder { list.move "weather-places" from="{event.from}" to="{event.to}" }
            each place in="{var.weather-places}" key="{place.id}" index="i" {
                row class="settings-row settings-module-row" {
                    button class="settings-choice-button" checked="{place.id == var.weather-selected}" {
                        on-click { set "weather-selected" "{place.id}" }
                        use "settings-choice" title="{place.name ?? 'Unnamed Place'}" detail="{place.region ?? ''}" checked="{place.id == var.weather-selected}"
                    }
                    spacer
                    button class="settings-icon-button" tooltip="Remove" {
                        on-click {
                            list.remove "weather-places" key="{place.id}"
                            when "{place.id == var.weather-selected}" { set "weather-selected" "{(var.weather-places | where-not 'id' place.id | first).id ?? null}" }
                        }
                        icon "minus.circle.fill"
                    }
                }
            }
        }
    }
    column class="settings-group" {
        text "Search for a Place" class="settings-group-title"
        input bind="var.settings-weather-query" placeholder="City or Place" class="settings-search" {
            on-change debounce="400ms" { weather.search "{event.value}" }
        }
        when "{weather.search-status == 'searching'}" { text "Searching…" class="settings-row-detail" }
        when "{weather.search-status == 'failed'}" { text "The search failed. Check the connection and try again." class="settings-warning" }
        when "{weather.search-status == 'done' && (weather.search-results | count) == 0}" { text "No places found." class="settings-row-detail" }
        each result in="{weather.search-results}" key="{result.latitude}:{result.longitude}" {
            row class="settings-row settings-result" {
                column class="settings-row-text" {
                    text "{result.name}" class="settings-row-title"
                    text "{result.region ?? ''}{result.region != null && result.country != null ? ', ' : ''}{result.country ?? ''}" class="settings-row-detail"
                }
                spacer
                button class="settings-icon-button" tooltip="Add to Favorites" disabled="{(var.weather-places | where 'latitude' result.latitude | where 'longitude' result.longitude | count) > 0}" {
                    on-click {
                        list.insert "weather-places" { - id="{result.latitude}:{result.longitude}" name="{result.name}" region="{result.region}" country="{result.country}" latitude="{result.latitude}" longitude="{result.longitude}" }
                        when "{var.weather-selected == null}" { set "weather-selected" "{result.latitude}:{result.longitude}" }
                    }
                    icon "{(var.weather-places | where 'latitude' result.latitude | where 'longitude' result.longitude | count) > 0 ? 'checkmark.circle.fill' : 'plus.circle.fill'}"
                }
            }
        }
    }
    column class="settings-preview settings-dashboard-preview" label="Preview of the Dashboard" {
        text "Preview" class="settings-group-title"
        stack class="settings-preview-frame settings-dashboard-frame" {
            column class="dashboard" {
                use "dashboard-overview"
            }
        }
    }
}

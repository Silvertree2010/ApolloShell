overlay "wm-tab-bars" screen="all" click-through="auto" {
    stack style="width: 100%; height: 100%" {
        each bar in="{wm.tab-bars | where 'screen' screen.id}" key="{bar.active}" {
            row class="wm-tab-bar" style="align-self: start; justify-self: start; margin: {bar.y}px 0 0 {bar.x}px; width: {bar.width}px; height: {bar.height}px" {
                each tab in="{bar.tabs}" key="{tab.window}" {
                    button class="{tab.window == bar.active ? 'wm-tab active' : 'wm-tab'}" tooltip="{tab.app}" {
                        on-click { wm.focus-window "{tab.window}" }
                        text "{tab.title}"
                    }
                }
            }
        }
    }
}

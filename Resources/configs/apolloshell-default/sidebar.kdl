var sidebar-modules "{var.sidebar-caelestia}" type="list" persist=#true
var sidebar-screens "all" persist=#true
var sidebar-background "material" persist=#true
var status-popout ""
var dock-first-running from="{apps.dock | index-where 'section' ['running']}"

define "sidebar-icon" {
    param "icon"
    param "fallback" default=#null
    param "tooltip" default=""
    param "glyph" default=""
    button class="sidebar-icon" tooltip="{tooltip}" {
        icon "{icon}" fallback="{fallback}" class="sidebar-glyph {glyph}"
        slot
    }
}

define "sidebar-dashboard-button" {
    param "module"
    use "sidebar-icon" icon="bar-dashboard" fallback="square.grid.2x2" tooltip="Dashboard" {
        on-click { toggle "dashboard" }
    }
}

define "sidebar-utilities-button" {
    param "module"
    use "sidebar-icon" icon="bar-utilities" fallback="slider.horizontal.3" tooltip="Utilities" {
        on-click { toggle "utilities" }
    }
}

define "sidebar-power" {
    param "module"
    use "sidebar-icon" icon="bar-power" fallback="power" tooltip="Session" glyph="power-glyph" {
        on-click { toggle "session" }
    }
}

define "sidebar-media-button" {
    param "module"
    use "sidebar-icon" icon="panel-media" fallback="music.note" tooltip="Media" glyph="sidebar-media-glyph" {
        on-click { set "dashboard-tab" "media"; open "dashboard" }
    }
}

define "sidebar-spaces" {
    param "module"
    switch "{module.style}" {
        case "pills" { use "sidebar-spaces-face" module="{module}" }
        case "bars" { use "sidebar-spaces-face" module="{module}" }
        default {
            stack class="sidebar-spaces style-{module.style}" {
                column class="space-track" {
                    when "{(spaces.list | where 'fullscreen' false | map 'active' | index-of true) != null}" {
                        stack class="space-pill" style="margin: {(spaces.list | where 'fullscreen' false | map 'active' | index-of true) * 29}px 0 0 0"
                    }
                }
                column class="space-list" {
                    each space in="{spaces.list | where 'fullscreen' false}" key="{space.id}" {
                        button class="space" checked="{space.active}" tooltip="Desktop {space.index}" {
                            on-click { spaces.switch "{space.index}" }
                            stack {
                                when "{module.style == 'numbers'}" { text "{space.index}" class="space-number" }
                                else { stack class="space-dot" }
                            }
                        }
                    }
                }
            }
        }
    }
}

define "sidebar-spaces-face" {
    param "module"
    column class="sidebar-spaces face-{module.style}" {
        each space in="{spaces.list | where 'fullscreen' false}" key="{space.id}" {
            button class="space-face" checked="{space.active}" tooltip="To Desktop {space.index}" {
                on-click { spaces.switch "{space.index}" }
                stack class="space-mark"
            }
        }
    }
}

define "sidebar-clock-text" {
    param "module"
    column class="sidebar-clock-column" {
        when "{module.show-icon}" { icon "bar-clock" fallback="calendar" class="sidebar-clock-icon" }
        when "{module.show-date}" {
            column class="sidebar-clock-date-stack" {
                text "{clock.now | date 'EEE'}" class="sidebar-clock-date"
                text "{clock.now | date 'd'}" class="sidebar-clock-date second"
            }
        }
        text "{clock.now | date 'HH'}" class="sidebar-clock-hour"
        text "{clock.now | date 'mm'}" class="sidebar-clock-minute"
    }
}

define "sidebar-clock" {
    param "module"
    button class="sidebar-clock style-{module.style ?? 'stacked'}" {
        on-click { toggle "dashboard" }
        when "{(module.style ?? 'stacked') == 'badge'}" {
            stack class="sidebar-clock-badge" { use "sidebar-clock-text" module="{module}" }
        }
        else { use "sidebar-clock-text" module="{module}" }
    }
}

define "bluetooth-glyph" {
    param "enabled"
    icon "{enabled ? 'status-bluetooth' : 'status-bluetooth-off'}" fallback="builtin:bluetooth-rune" class="status-glyph bluetooth-glyph {enabled ? '' : 'off'}"
}

define "sidebar-status-icons" {
    param "module"
    column class="status-capsule" {
        when "{module.wifi}" {
            button id="status-wifi" class="sidebar-icon status-icon" checked="{var.status-popout == 'wifi'}" tooltip="{!network.wifi.on ? 'Wi-Fi Off' : (network.wifi.connected ? 'Wi-Fi ' + network.wifi.rssi + ' dBm' : 'Wi-Fi On, Not Connected')}" {
                on-click { set "status-popout" "{var.status-popout == 'wifi' ? '' : 'wifi'}" }
                icon "{network.wifi.on == false ? 'status-wifi-off' : 'status-wifi'}" fallback="{network.wifi.symbol}" class="status-glyph"
            }
        }
        when "{module.bluetooth}" {
            button id="status-bluetooth" class="sidebar-icon status-icon" checked="{var.status-popout == 'bluetooth'}" tooltip="{bluetooth.on == null ? 'Bluetooth' : (bluetooth.on ? 'Bluetooth On' : 'Bluetooth Off')}" {
                on-click { set "status-popout" "{var.status-popout == 'bluetooth' ? '' : 'bluetooth'}" }
                use "bluetooth-glyph" enabled="{bluetooth.on != false}"
            }
        }
        when "{module.battery && battery.present}" {
            button id="status-battery" class="sidebar-icon status-icon" checked="{var.status-popout == 'battery'}" tooltip="{battery.state-text}" {
                on-click { set "status-popout" "{var.status-popout == 'battery' ? '' : 'battery'}" }
                icon "{battery.charging ? 'status-battery-charging' : 'status-battery'}" fallback="{battery.symbol}" class="status-glyph battery-glyph"
            }
        }
    }
}

define "sidebar-spacer" {
    param "module"
    spacer class="sidebar-spacer"
}

define "sidebar-gap" {
    param "module"
    spacer size="{module.height ?? 16 | clamp 4 96}"
}

define "sidebar-divider" {
    param "module"
    stack class="sidebar-divider"
}

define "sidebar-app-button" {
    param "module"
    when "{module.bundle-id != ''}" {
        button class="sidebar-icon sidebar-app" tooltip="{(apps.all | where 'bundle-id' module.bundle-id | first).name ?? module.bundle-id}" {
            on-click { apps.launch "{module.bundle-id}" }
            app-icon "{module.bundle-id}" class="sidebar-app-icon"
        }
    }
    else {
        icon "app.dashed" class="sidebar-glyph sidebar-app-placeholder"
    }
}

define "sidebar-battery" {
    param "module"
    when "{battery.present}" {
        button class="sidebar-tile sidebar-battery {battery.percent < 0.2 && !battery.charging ? 'low' : ''}" {
            on-click { set "dashboard-tab" "performance"; open "dashboard" }
            column class="sidebar-tile-stack" {
                when "{module.show-icon}" { icon "{battery.charging ? 'status-battery-charging' : 'status-battery'}" fallback="{battery.symbol}" class="battery-glyph" }
                text "{battery.percent | percent}" class="sidebar-tile-value"
            }
        }
    }
}

define "sidebar-cpu" {
    param "module"
    button class="sidebar-tile sidebar-cpu" {
        on-click { set "dashboard-tab" "performance"; open "dashboard" }
        switch "{module.style}" {
            case "percent" {
                column class="sidebar-tile-stack" {
                    icon "panel-cpu" fallback="cpu" class="sidebar-tile-glyph"
                    text "{perf.cpu | percent}" class="sidebar-tile-value"
                }
            }
            default {
                stack {
                    ring value="{perf.cpu}" class="sidebar-cpu-ring"
                    text "{perf.cpu * 100 | round}" class="sidebar-cpu-number"
                }
            }
        }
    }
}

define "sidebar-weather" {
    param "module"
    button class="sidebar-tile sidebar-weather" {
        on-click { set "dashboard-tab" "weather"; open "dashboard" }
        column class="sidebar-tile-stack" {
            icon "{weather.current.symbol ?? 'cloud.sun.fill'}" class="weather-glyph"
            when "{module.show-temperature && weather.status == 'ready'}" { text "{weather.current.temperature | temperature}" class="sidebar-tile-value" }
        }
    }
}

define "sidebar-apple-menu" {
    param "module"
    button class="sidebar-icon" tooltip="Apple Menu" menu-on="click" {
        menu side="right" offset=3 { source "app-menubar" index=0 }
        icon "apple.logo" class="sidebar-glyph"
    }
}

define "sidebar-app-menus" {
    param "module"
    button class="sidebar-icon" tooltip="App Menus" menu-on="click" {
        menu side="right" offset=3 { source "app-menubar" overflow=#true }
        icon "menubar.rectangle" fallback="macwindow" class="sidebar-glyph"
    }
}

define "sidebar-wifi" {
    param "module"
    button id="status-wifi" class="sidebar-icon status-icon" checked="{var.status-popout == 'wifi'}" tooltip="{!network.wifi.on ? 'Wi-Fi Off' : (network.wifi.connected ? 'Wi-Fi ' + network.wifi.rssi + ' dBm' : 'Wi-Fi On, Not Connected')}" {
        on-click { set "status-popout" "{var.status-popout == 'wifi' ? '' : 'wifi'}" }
        icon "{network.wifi.on == false ? 'status-wifi-off' : 'status-wifi'}" fallback="{network.wifi.symbol}" class="status-glyph"
    }
}

define "sidebar-bluetooth" {
    param "module"
    button id="status-bluetooth" class="sidebar-icon status-icon" checked="{var.status-popout == 'bluetooth'}" tooltip="{bluetooth.on == null ? 'Bluetooth' : (bluetooth.on ? 'Bluetooth On' : 'Bluetooth Off')}" {
        on-click { set "status-popout" "{var.status-popout == 'bluetooth' ? '' : 'bluetooth'}" }
        use "bluetooth-glyph" enabled="{bluetooth.on != false}"
    }
}

define "sidebar-keyboard-layout" {
    param "module"
    button class="sidebar-tile sidebar-keyboard" tooltip="{keyboard.source.name}" {
        on-click { keyboard.next-source }
        column class="sidebar-tile-stack" {
            when "{module.show-icon}" { icon "keyboard" class="sidebar-tile-glyph" }
            text "{keyboard.source.short}" class="sidebar-keyboard-text"
        }
    }
}

define "sidebar-network-speed" {
    param "module"
    button class="sidebar-tile sidebar-network" tooltip="↓ {perf.net-down | bytes-per-second}  ↑ {perf.net-up | bytes-per-second}" {
        on-click { set "dashboard-tab" "performance"; open "dashboard" }
        column class="sidebar-network-lines" {
            row class="sidebar-network-line" {
                icon "arrow.down" class="sidebar-network-arrow down"
                text "{perf.net-down | bytes}" class="sidebar-network-value"
            }
            row class="sidebar-network-line" {
                icon "arrow.up" class="sidebar-network-arrow up"
                text "{perf.net-up | bytes}" class="sidebar-network-value"
            }
        }
    }
}

define "sidebar-now-playing" {
    param "module"
    when "{media.title != null && media.title != ''}" {
        column class="sidebar-now-playing" {
            button class="sidebar-icon" tooltip="{media.title} · {media.artist}" {
                on-click { set "dashboard-tab" "media"; open "dashboard" }
                image "{media.artwork}" fit="fill" class="sidebar-now-playing-art"
            }
            when "{module.show-controls ?? true}" {
                button class="sidebar-icon" tooltip="{media.playing ? 'Pause' : 'Play'}" {
                    on-click { media.play-pause }
                    icon "{media.playing ? 'pause.fill' : 'play.fill'}" class="sidebar-glyph"
                }
            }
        }
    }
}

define "sidebar-status-items" {
    param "module"
    column class="sidebar-status-items" {
        each item in="{status-items.list}" key="{item.id}" {
            button class="sidebar-icon sidebar-status-item" tooltip="{item.name == '' ? 'Status Item' : item.name}" menu-on="click" {
                menu side="right" offset=3 { source "status-item" item="{item}" }
                when "{item.image != null}" {
                    image "{item.image}" class="menubar-status-image {item.monochrome ? 'template' : ''}"
                }
                else {
                    when "{item.symbol != null}" {
                        icon "{item.symbol}" class="menubar-status-symbol {item.monochrome ? 'template' : 'original'}"
                    }
                    else {
                        when "{item.title != ''}" { text "{item.title}" class="sidebar-status-text" }
                        else { icon "questionmark.square.dashed" class="menubar-status-symbol template fallback" }
                    }
                }
            }
        }
    }
}

define "sidebar-system-stats" {
    param "module"
    button class="sidebar-tile sidebar-stats" tooltip="CPU {perf.cpu | percent}, Memory {perf.memory | percent}" {
        on-click { set "dashboard-tab" "performance"; open "dashboard" }
        column class="sidebar-tile-stack" {
            when "{(module.show-cpu ?? true) || !(module.show-memory ?? true)}" {
                column class="sidebar-stat" {
                    icon "cpu" class="sidebar-stat-glyph"
                    text "{perf.cpu | percent}" class="sidebar-tile-value"
                }
            }
            when "{module.show-memory ?? true}" {
                column class="sidebar-stat" {
                    icon "memorychip" class="sidebar-stat-glyph"
                    text "{perf.memory | percent}" class="sidebar-tile-value"
                }
            }
        }
    }
}

define "sidebar-timer" {
    param "module"
    button class="sidebar-tile sidebar-timer" tooltip="{timer.running == false && timer.elapsed == 0 ? 'Timer' : (timer.remaining != null ? (timer.remaining | ceil | duration) : (timer.elapsed | floor | duration))}" menu-on="right-click long-press" {
        on-click {
            when "{timer.running}" { timer.pause }
            else { timer.resume }
        }
        menu side="right" offset=3 {
            item "Reset" disabled="{timer.running == false && timer.elapsed == 0}" { timer.reset }
            each minutes in="{[5, 10, 15, 25]}" {
                item "{minutes} Minutes" { timer.start "{minutes}" }
            }
        }
        when "{timer.running == false && timer.elapsed == 0}" {
            icon "timer" class="sidebar-timer-glyph"
        }
        else {
            stack class="sidebar-timer-stack {timer.running ? 'running' : ''}" {
                ring value="{timer.mode == 'stopwatch' ? (timer.elapsed % 60) / 60 : 1 - (timer.elapsed / timer.duration | min 1)}" class="sidebar-timer-ring"
                text "{(timer.remaining ?? timer.elapsed) >= 100 ? (((timer.remaining ?? timer.elapsed) / 60 | ceil) + 'm') : ((timer.remaining ?? timer.elapsed) | ceil)}" class="sidebar-timer-text"
            }
        }
    }
}

define "sidebar-volume" {
    param "module"
    button class="sidebar-tile sidebar-volume" tooltip="{audio.output.name}" {
        on-click { audio.toggle-mute }
        on-scroll step=1 { audio.change-volume "{event.direction == 'up' ? 0.05 : -0.05}" }
        column class="sidebar-tile-stack" {
            icon "{audio.symbol}" class="sidebar-tile-glyph"
            when "{module.show-percent ?? true}" { text "{audio.volume | percent}" class="sidebar-tile-value" }
        }
    }
}

define "sidebar-window-title" {
    param "module"
    when "{window.app != null}" {
        stack class="sidebar-icon sidebar-window" tooltip="{window.title ?? window.app.name}" {
            app-icon "{window.app}" class="sidebar-app-icon"
        }
    }
}

define "dock-item" {
    param "app"
    param "size"
    button class="dock-item size-{size} {app.active ? 'front' : ''} {app.hidden ? 'hidden' : ''} {app.launching ? 'launching' : ''}" tooltip="{app.name}" label="{app.running ? app.name + ', running' : app.name}" menu-on="right-click long-press" {
        on-click { apps.click "{app}" modifiers="{event.modifiers}" }
        on-scroll step=30 cooldown="300ms" { apps.cycle-windows "{app}" "{event.direction}" }
        on-drop accept="files" { apps.open-files "{app}" "{event.files}" }
        menu side="right" offset=6 {
            source "app-dock" app="{app}" fallback="full"
        }
        stack {
            app-icon "{app}" class="dock-icon" badge="{app.badge}"
            when "{app.running}" { stack class="dock-running-dot" }
        }
    }
}

define "sidebar-dock" {
    param "module"
    include "dock.kdl"
}

define "popout-row" {
    param "title"
    param "value"
    when "{value != null && value != ''}" {
        row class="popout-row" {
            text "{title}" class="popout-row-title"
            spacer
            text "{value}" class="popout-row-value"
        }
    }
}

define "popout-lead" {
    param "symbol"
    param "strength" default=1
    param "active" default=#true
    param "title"
    param "subtitle" default=""
    row class="popout-status" {
        stack class="popout-status-circle {active ? '' : 'off'}" {
            icon "{symbol}" variable="{strength}" class="popout-status-glyph"
        }
        column class="popout-status-text" {
            text "{title}" class="popout-status-title" lines=1
            when "{subtitle != ''}" { text "{subtitle}" class="popout-status-subtitle" lines=1 }
        }
    }
}

define "popout-link" {
    param "title"
    button class="popout-link" {
        slot
        row class="popout-link-content" {
            icon "gearshape" class="popout-link-glyph"
            text "{title}"
        }
    }
}

define "popout-wifi" {
    column class="popout popout-wifi" {
        row class="popout-header" {
            text "Wi-Fi" class="popout-title"
            spacer
            toggle checked="{network.wifi.on}" class="popout-switch" {
                on-change { network.set-wifi "{event.value}" }
            }
        }
        when "{network.wifi.on && network.wifi.connected}" {
            use "popout-lead" symbol="wifi" strength="{network.wifi.bars / 3}" title="Connected" subtitle="Network name needs Location Services"
            column class="popout-card" {
                use "popout-row" title="Signal" value="{network.wifi.rssi != null ? network.wifi.rssi + ' dBm · ' + network.wifi.quality : null}"
                use "popout-row" title="Noise" value="{network.wifi.noise != null ? network.wifi.noise + ' dBm' + (network.wifi.snr != null ? ' · SNR ' + network.wifi.snr + ' dB' : '') : null}"
                use "popout-row" title="Transmit Rate" value="{network.wifi.tx-rate != null ? (network.wifi.tx-rate | round) + ' Mbit/s' : null}"
                use "popout-row" title="Standard" value="{network.wifi.standard}"
                use "popout-row" title="Channel" value="{network.wifi.channel != null ? network.wifi.channel + (network.wifi.band != null ? ' · ' + network.wifi.band : '') : null}"
                use "popout-row" title="Interface" value="{network.wifi.interface}"
            }
        }
        else {
            use "popout-lead" symbol="{network.wifi.on ? 'wifi' : 'wifi.slash'}" strength=0 active=#false title="{network.wifi.on == null ? 'No Wi-Fi Interface' : (network.wifi.on ? 'Not Connected' : 'Wi-Fi Is Off')}" subtitle="{network.wifi.on ? 'No Network in Range Connected' : ''}"
        }
        use "popout-link" title="Wi-Fi Settings…" {
            on-click { network.open-settings; set "status-popout" "" }
        }
    }
}

define "popout-bluetooth" {
    column class="popout popout-bluetooth" {
        row class="popout-header" {
            text "Bluetooth" class="popout-title"
            spacer
            stack class="popout-capsule {bluetooth.on ? 'on' : 'off'}" tooltip="{bluetooth.on ? 'Bluetooth is on' : 'Bluetooth is off'}" {
                text "{bluetooth.on == null ? '–' : (bluetooth.on ? 'On' : 'Off')}" class="popout-capsule-text"
            }
        }
        switch "{bluetooth.status}" {
            case "reading" { text "Reading devices…" class="popout-hint" }
            case "unavailable" { text "Bluetooth state unavailable" class="popout-hint" }
            default {
                text "{bluetooth.paired == 0 ? 'No paired devices' : (bluetooth.paired == 1 ? '1 paired device' : bluetooth.paired + ' paired devices') + (bluetooth.connected == 0 ? ', none connected' : ', ' + bluetooth.connected + ' connected')}" class="popout-hint"
            }
        }
        when "{(bluetooth.devices | count) > 0}" {
            column class="popout-devices" {
                each device in="{bluetooth.devices}" key="{device.name + device.kind}" {
                    row class="popout-status popout-device" {
                        stack class="popout-status-circle" {
                            icon "{device.symbol}" fallback="headphones" class="popout-device-glyph"
                        }
                        column class="popout-status-text" {
                            text "{device.name}" class="popout-status-title" lines=1 truncate="tail"
                            row class="popout-device-batteries" {
                                use "popout-device-battery" label="" level="{device.battery.main}"
                                use "popout-device-battery" label="L" level="{device.battery.left}"
                                use "popout-device-battery" label="R" level="{device.battery.right}"
                                use "popout-device-battery" label="Case" level="{device.battery.case}"
                            }
                        }
                    }
                }
            }
        }
        use "popout-link" title="Bluetooth Settings…" {
            on-click { bluetooth.open-settings; set "status-popout" "" }
        }
    }
}

define "popout-device-battery" {
    param "label"
    param "level"
    when "{level != null}" {
        row class="popout-device-battery-part" {
            when "{label != ''}" { text "{label}" class="popout-device-battery-label" }
            text "{(level * 100 | round) + ' %'}" class="popout-device-battery {level < 0.2 ? 'low' : ''}"
        }
    }
}

define "popout-battery" {
    column class="popout popout-battery" {
        row class="popout-battery-head" {
            text "{battery.percent * 100 | round}" class="popout-battery-percent"
            text "%" class="popout-battery-unit"
            spacer
            icon "{battery.symbol}" fallback="battery.100" class="popout-battery-glyph {battery.charging ? 'popout-battery-bolt' : ''}"
        }
        column class="popout-status-text" {
            text "{battery.state-text}" class="popout-battery-state"
            when "{battery.time-text != null && battery.time-text != ''}" { text "{battery.time-text}" class="popout-hint" }
        }
        column class="popout-card" {
            use "popout-row" title="Low Power Mode" value="{battery.low-power-mode ? 'On' : 'Off'}"
            use "popout-row" title="Maximum Capacity" value="{battery.health != null ? (battery.health * 100 | round) + ' %' : null}"
            use "popout-row" title="Charge Cycles" value="{battery.cycles}"
        }
        use "popout-link" title="Battery Settings…" {
            on-click { system.open-settings "battery"; set "status-popout" "" }
        }
    }
}

panel "sidebar" anchor="left" area="below-menubar" reserve=#true shape="fused" fuse-group="shell" fuse-fill=#true fullscreen="hide" screen="{var.sidebar-screens}" style="{var.menubar-active && (var.menubar-screens == 'all' || var.menubar-screens == screen.id || (var.menubar-screens == 'main' && screen.main)) ? 'margin-top: ' + (var.menubar-covers ? (var.menubar-extent - (screen.menubar-height ?? 0) | max 0) : var.menubar-extent) + 'px' : ''}" class="{theme.set['bar-color'] || theme.set['bar-gradient'] ? 'themed' : 'bg-' + var.sidebar-background}" {
    when "{var.shell-editing}" {
        reorderable axis="vertical" enabled=#true accept="value" class="sidebar-modules" {
            on-reorder { list.move "sidebar-modules" from="{event.from}" to="{event.to}" }
            on-drop accept="value" { use "edit-add-bar" list="sidebar-modules" catalog="{var.sidebar-module-kinds}" kind="{event.value}" present="{var.sidebar-modules}" at="{event.index}" }
            each module in="{var.sidebar-modules}" key="{module.id}" {
                use "edit-frame" list="sidebar-modules" key="{module.id}" grow="{module.kind == 'dock' || module.kind == 'spacer'}" {
                    use "sidebar-{module.kind}" module="{module}"
                }
            }
        }
    }
    else {
        column class="sidebar-modules" {
            each module in="{var.sidebar-modules | where-not 'kind' var.feature-off-a | where-not 'kind' var.feature-off-b}" key="{module.id}" {
                use "sidebar-{module.kind}" module="{module}"
            }
        }
    }
    use "edit-opt-sidebar"
    flyout id="status-popout" anchor="{'status-' + var.status-popout}" side="right" open="{var.status-popout != ''}" {
        on-close { set "status-popout" "" }
        switch "{var.status-popout}" {
            case "wifi" { use "popout-wifi" }
            case "bluetooth" { use "popout-bluetooth" }
            case "battery" { use "popout-battery" }
        }
    }
}

bind "escape" when="{var.status-popout != ''}" { set "status-popout" "" }

include "presets.kdl"

var weather-source "open-meteo" persist=#true
var weather-places "{[]}" type="list" persist=#true
var weather-selected #null type="any" persist=#true
var file-manager #null type="any" persist=#true
var hide-apple-dock "{!shell.fresh-install}" persist=#true
var keep-awake-lid "{!shell.fresh-install}" persist=#true
var onboarding-done "{!shell.fresh-install}" persist=#true
var hotkey-dashboard "{shell.fresh-install ? 'ctrl+alt+d' : 'hyper+d'}" persist=#true
var hotkey-utilities "{shell.fresh-install ? 'ctrl+alt+u' : 'hyper+u'}" persist=#true
var hotkey-settings "{shell.fresh-install ? 'ctrl+alt+comma' : 'hyper+comma'}" persist=#true

weather source="{var.weather-source}" place="{var.weather-places | where 'id' var.weather-selected | first}"
apps file-manager="{var.file-manager}"
power lid-closed="{var.keep-awake-lid}"

on "shell.started" { system.hide-apple-dock "{var.hide-apple-dock}" }

bind "{var.hotkey-dashboard}" { toggle "dashboard" }
bind "{var.hotkey-utilities}" { toggle "utilities" }
bind "{var.hotkey-settings}" { open "settings" }

command-center {
    items {
        builtin "reload-config"
        builtin "restart"
        builtin "problems"
        separator
        item "Settings…" { open "settings" }
        builtin "configs"
        builtin "themes"
        builtin "marketplace"
        separator
        builtin "updates"
        builtin "crash-reports"
        builtin "login-item"
        builtin "install-cli"
        separator
        builtin "about"
        builtin "quit"
    }
}

include "sidebar.kdl"
include "launcher.kdl"
include "dashboard.kdl"
include "utilities.kdl"
include "session.kdl"
include "osd.kdl"
include "toasts.kdl"
include "desktop-clock.kdl"
include "onboarding.kdl"
include "settings/window.kdl"

style "style.css"

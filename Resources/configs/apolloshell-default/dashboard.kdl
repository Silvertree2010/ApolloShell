var dashboard-tabs "{var.dashboard-caelestia.tabs}" type="list" persist=#true
var dashboard-cards-top "{var.dashboard-caelestia.top}" type="list" persist=#true
var dashboard-cards-bottom "{var.dashboard-caelestia.bottom}" type="list" persist=#true
var dashboard-cards-side "{var.dashboard-caelestia.side}" type="list" persist=#true
var dashboard-tab "dashboard"
var calendar-offset 0

var dashboard-pages "{var.dashboard-default-pages}" type="list" persist=#true
var dashboard-widgets "{var.dashboard-default-overview | concat var.dashboard-default-performance-plain}" type="list" persist=#true
var dashboard-seeded #false persist=#true
var dashboard-scale 1 persist=#true
var shell-editing #false
var dashboard-selected #null type="any"
var dashboard-new-id ""
var dashboard-backup-pages #null type="any"
var dashboard-backup-widgets #null type="any"
var dashboard-backup-scale #null type="any"
var dashboard-selected-widget from="{var.dashboard-widgets | where 'id' var.dashboard-selected | first}"
var dashboard-active-page-record from="{var.dashboard-pages | where 'id' var.dashboard-active-page | first}"
var dashboard-active-page from="{((var.dashboard-pages | where 'id' var.dashboard-tab | first) ?? (var.dashboard-pages | where 'template' var.dashboard-tab | first) ?? (var.dashboard-pages | first)).id}"
var dashboard-page-widgets from="{var.dashboard-widgets | where 'page' var.dashboard-active-page}"
var dashboard-frame {
    - id="dashboard" x=0 y=0 width=871 height=482
}

include "dashboard-cards.kdl"
include "dashboard-options.kdl"
include "media.kdl"
include "performance.kdl"
include "weather.kdl"
include "widgets.kdl"

define "dashboard-overview" {
    use "dashboard-canvas" widgets="{var.dashboard-widgets | where 'page' 'dashboard'}"
}

on "shell.started" when="{!var.dashboard-seeded}" {
    when "{battery.present == true}" { set "dashboard-widgets" "{var.dashboard-default-widgets}" }
    set "dashboard-seeded" #true
}

define "bento-item" {
    param "w"
    stack id="bi-{w.id}" class="bento-item{var.shell-editing ? ' editing' : ''}{var.shell-editing && w.id == var.dashboard-selected ? ' selected' : ''}" {
        use "widget" w="{w}"
        when "{var.shell-editing}" {
            stack class="bento-cover" {
                on-click {
                    set "dashboard-selected" "{w.id}"
                    set "dashboard-options" "{w.id}"
                    set "dashboard-tz-open" #false
                    set "dashboard-app-open" #false
                }
            }
            icon "arrow.down.right" class="bento-corner"
            button class="bento-badge" tooltip="Remove" {
                on-click {
                    when "{var.dashboard-selected == w.id}" {
                        set "dashboard-selected" #null
                        set "dashboard-options" #null
                    }
                    list.remove "dashboard-widgets" key="{w.id}"
                }
                icon "minus" class="bento-badge-glyph"
            }
        }
    }
}

define "dashboard-canvas" {
    param "widgets"
    when "{(widgets | count) == 0}" {
        column class="card dashboard-empty" {
            on-drop accept="value" {
                set "dashboard-new-id" "{clock.now | date 'yyyyMMddHHmmssSSS'}"
                list.insert "dashboard-widgets" { - id="{var.dashboard-new-id}" page="{var.dashboard-active-page}" kind="{event.value}" x="{(var.dashboard-page-widgets | place-frame var.widget-kinds event.value event.x event.y).x}" y="{(var.dashboard-page-widgets | place-frame var.widget-kinds event.value event.x event.y).y}" width="{(var.dashboard-page-widgets | place-frame var.widget-kinds event.value event.x event.y).width}" height="{(var.dashboard-page-widgets | place-frame var.widget-kinds event.value event.x event.y).height}" display="standard" }
                use "widget-seed" i="{var.dashboard-new-id}" k="{event.value}"
            }
            icon "square.grid.2x2" class="dashboard-empty-glyph"
            text "Empty page" class="dashboard-empty-title"
            text "Settings › Edit Interface" class="dashboard-empty-detail"
        }
    }
    else {
        canvas class="dashboard-canvas" in="{widgets}" sizes="{var.widget-kinds}" enabled="{var.shell-editing}" {
            on-move {
                when "{event.phase == 'ended' && event.valid}" { list.update "dashboard-widgets" key="{event.key}" { - x="{event.x}" y="{event.y}" } }
            }
            on-resize {
                when "{event.phase == 'ended' && event.valid}" { list.update "dashboard-widgets" key="{event.key}" { - x="{event.x}" y="{event.y}" width="{event.width}" height="{event.height}" } }
            }
            on-drop accept="value" {
                set "dashboard-new-id" "{clock.now | date 'yyyyMMddHHmmssSSS'}"
                list.insert "dashboard-widgets" { - id="{var.dashboard-new-id}" page="{var.dashboard-active-page}" kind="{event.value}" x="{(var.dashboard-page-widgets | place-frame var.widget-kinds event.value event.x event.y).x}" y="{(var.dashboard-page-widgets | place-frame var.widget-kinds event.value event.x event.y).y}" width="{(var.dashboard-page-widgets | place-frame var.widget-kinds event.value event.x event.y).width}" height="{(var.dashboard-page-widgets | place-frame var.widget-kinds event.value event.x event.y).height}" display="standard" }
                use "widget-seed" i="{var.dashboard-new-id}" k="{event.value}"
            }
            each w in="{widgets}" key="{w.id}" {
                use "bento-item" w="{w}"
            }
        }
    }
}

define "dashboard-page-tab" {
    param "page"
    param "i"
    button class="dashboard-tab" checked="{page.id == var.dashboard-active-page}" {
        on-click { set "dashboard-tab" "{page.id}"; set "dashboard-selected" #null }
        when "{var.shell-editing}" {
            menu {
                item "Rename" { set "dashboard-renaming" "{page.id}" }
                submenu "Icon" {
                    each sy in="{var.dashboard-symbols}" key="{sy.symbol}" {
                        item "{sy.symbol}" { list.update "dashboard-pages" key="{page.id}" { - symbol="{sy.symbol}" icon=#null } }
                    }
                }
                item "Duplicate" {
                    set "dashboard-new-id" "page-{clock.now | date 'yyyyMMddHHmmssSSS'}"
                    list.insert "dashboard-pages" at="{i + 1}" { - id="{var.dashboard-new-id}" name="{page.name} 2" symbol="{page.symbol}" icon="{page.icon}" template="{page.template}" }
                    set "dashboard-widgets" "{var.dashboard-widgets | concat (var.dashboard-widgets | where 'page' page.id | with-field 'page' var.dashboard-new-id | prefix-field 'id' (var.dashboard-new-id + '-'))}"
                    set "dashboard-tab" "{var.dashboard-new-id}"
                }
                separator
                item "Delete" disabled="{(var.dashboard-pages | count) <= 1}" {
                    set "dashboard-widgets" "{var.dashboard-widgets | where-not 'page' page.id}"
                    list.remove "dashboard-pages" key="{page.id}"
                    set "dashboard-selected" #null
                }
            }
        }
        column class="dashboard-tab-label" {
            icon "{page.icon ?? page.symbol}" fallback="{page.symbol}{page.id == var.dashboard-active-page ? (page.template == 'dashboard' || page.template == 'weather' ? '.fill' : '') : ''}" class="dashboard-tab-glyph"
            when "{var.dashboard-renaming != page.id}" { text "{page.name}" class="dashboard-tab-title" }
            when "{var.dashboard-renaming == page.id}" {
                input value="{page.name}" placeholder="Name" class="dashboard-tab-rename" focus="{var.dashboard-renaming == page.id}" {
                    on-change { list.update "dashboard-pages" key="{page.id}" { - name="{event.value}" } }
                    on-submit { set "dashboard-renaming" #null }
                }
            }
        }
    }
}

popup "dashboard" anchor="top" motion="slide" fuse-group="shell" hover-edge="{!var.shell-editing}" overhang=#true area="full" safe-area=#true close-on="{var.shell-editing ? '' : 'outside-click escape focus-loss'}" scrim="{var.shell-editing ? 0.35 : 0}" style="margin-top: {(var.menubar-active && (var.menubar-screens == 'all' || var.menubar-screens == screen.id || (var.menubar-screens == 'main' && screen.main)) ? (var.menubar-covers ? (var.menubar-extent - (screen.menubar-height ?? 0) | max 0) : var.menubar-extent) : 0)}px" {
    on-open { set "calendar-offset" 0 }
    key "escape" {
        when "{var.shell-editing}" { use "edit-escape" }
        when "{!var.shell-editing}" { close "dashboard" }
    }
    canvas class="dashboard-scaler" scale="{var.dashboard-scale * (((screen.width ?? 1512) / 1512) | clamp 0.85 1.5) | min ((screen.width ?? 100000) / 871) | min (((screen.usable-height ?? 100000) - (var.menubar-active && (var.menubar-screens == 'all' || var.menubar-screens == screen.id || (var.menubar-screens == 'main' && screen.main)) ? (var.menubar-covers ? (var.menubar-extent - (screen.menubar-height ?? 0) | max 0) : var.menubar-extent) : 0)) / 482)}" {
        each frame in="{var.dashboard-frame}" key="{frame.id}" {
            column class="dashboard" {
                row class="dashboard-tabs" {
                    each page in="{var.dashboard-pages}" key="{page.id}" index="i" {
                        use "dashboard-page-tab" page="{page}" i="{i}"
                    }
                    when "{var.shell-editing}" {
                        button class="dashboard-tab dashboard-tab-add" tooltip="New Page" {
                            on-click {
                                set "dashboard-new-id" "page-{clock.now | date 'yyyyMMddHHmmssSSS'}"
                                list.insert "dashboard-pages" { - id="{var.dashboard-new-id}" name="Page {(var.dashboard-pages | count) + 1}" symbol="square.grid.2x2" }
                                set "dashboard-tab" "{var.dashboard-new-id}"
                                set "dashboard-selected" #null
                            }
                            column class="dashboard-tab-label" {
                                icon "plus" class="dashboard-tab-glyph"
                                text "" class="dashboard-tab-title"
                            }
                        }
                    }
                }
                row class="dashboard-tab-track" {
                    stack class="dashboard-tab-pill" style="margin: 0 0 0 {(((var.dashboard-pages | map 'id' | index-of var.dashboard-active-page) ?? 0) + 0.5) * (839 - (var.shell-editing ? 60 : 0)) / ((var.dashboard-pages | count) | max 1) - 22}px"
                }
                stack class="dashboard-divider"
                column class="dashboard-page" {
                    use "dashboard-canvas" widgets="{var.dashboard-page-widgets}"
                }
            }
        }
    }
    use "dashboard-options-flyout"
}

let session-actions {
    - id="logout" title="Log Out" icon="session-logout" symbol="rectangle.portrait.and.arrow.right" mood="think"
    - id="shutdown" title="Shut Down" icon="session-shutdown" symbol="power" mood="farewell"
    - id="sleep" title="Sleep" icon="session-sleep" symbol="moon.fill" mood="sleep"
    - id="restart" title="Restart" icon="session-restart" symbol="arrow.clockwise" mood="farewell"
}

var session-selection #null type="any"
var session-hover #null type="any"
var session-mood from="{var.session-hover != null ? (session-actions | where 'id' var.session-hover | first).mood : (var.session-selection != null ? (session-actions | at var.session-selection).mood : 'idle')}"

define "session-button" {
    param "action"
    param "index"
    button class="session-button {var.session-hover == action.id ? 'hovered' : ''}" checked="{var.session-selection == index}" tooltip="{action.title}" {
        on-click {
            close "session" wait=#true
            when "{action.id == 'logout'}" { session.logout }
            when "{action.id == 'shutdown'}" { session.shutdown }
            when "{action.id == 'sleep'}" { session.sleep }
            when "{action.id == 'restart'}" { session.restart }
        }
        on-hover { set "session-hover" "{action.id}" }
        on-hover-end { set "session-hover" #null }
        icon "{action.icon}" fallback="{action.symbol}" class="session-glyph"
    }
}

popup "session" anchor="right" scrim=0.15 overhang=#true {
    on-open { reset "session-selection"; reset "session-hover" }
    key "up" { set "session-selection" "{var.session-selection == null ? 0 : (var.session-selection - 1 | max 0)}" }
    key "down" { set "session-selection" "{var.session-selection == null ? 0 : (var.session-selection + 1 | min 3)}" }
    key "return" {
        when "{var.session-selection != null}" {
            close "session" wait=#true
            when "{var.session-selection == 0}" { session.logout }
            when "{var.session-selection == 1}" { session.shutdown }
            when "{var.session-selection == 2}" { session.sleep }
            when "{var.session-selection == 3}" { session.restart }
        }
    }
    column class="session" {
        use "session-button" action="{session-actions | at 0}" index=0
        use "session-button" action="{session-actions | at 1}" index=1
        stack class="session-emblem" {
            switch "{var.session-mood}" {
                case "farewell" { mark state="farewell" greet=#true class="session-mark" }
                case "sleep" { mark state="sleep" greet=#true class="session-mark" }
                case "think" { mark state="think" greet=#true class="session-mark" }
                default { mark state="idle" greet=#true class="session-mark" }
            }
        }
        use "session-button" action="{session-actions | at 2}" index=2
        use "session-button" action="{session-actions | at 3}" index=3
    }
}

include "widgets.kdl"
panel "bar" anchor="top" {
    text "A" id="clock"
    row id="clock" {
        use "card"
    }
    switch "{var.tab}" {
        default {
            text "x"
        }
        case "a" {
            text "y"
        }
    }
    buton {
    }
}
panel "extra" override=#true {
}
var tab "a"
